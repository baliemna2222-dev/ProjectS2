<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.FilmAdminController"
      fx:id="rootContainer"
      stylesheets="@/view/css/style.css"
      spacing="0"
      styleClass="admin-root"
      style="-fx-font-family: 'Segoe UI', sans-serif;">

    <!-- ══════════════════════════════════════════════════
         TOP NAV BAR
    ══════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="admin-page-header">

        <Label text="Films  C R U D"
               style="-fx-text-fill: #8cc9ff; -fx-font-size: 22px;
                      -fx-font-weight: bold; -fx-letter-spacing: 4px;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Search -->
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-background-color: rgba(66,165,245,0.12);
                     -fx-background-radius: 24; -fx-padding: 8 16;
                     -fx-border-color: rgba(66,165,245,0.22); -fx-border-radius: 24;">
            <Label text="🔍" style="-fx-text-fill: #cfe8ff;"/>
            <TextField fx:id="searchField"
                       promptText="Search films, director, genre, year…"
                       prefWidth="260"
                       style="-fx-background-color: transparent; -fx-text-fill: white;
                              -fx-prompt-text-fill: rgba(255,255,255,0.55); -fx-border-width: 0;"/>
        </HBox>

        <!-- Film count badge -->
        <Label fx:id="filmCountLabel" text="0 films" styleClass="admin-badge"/>
    </HBox>

    <!-- ══════════════════════════════════════════════════ -->
    <HBox VBox.vgrow="ALWAYS" spacing="0">

        <!-- ── LEFT SIDEBAR – FORM ──────────────────── -->
        <ScrollPane fitToWidth="true" styleClass="admin-sidebar-panel" prefWidth="380" minWidth="340">

            <VBox fx:id="formPanel" spacing="16" styleClass="admin-form-panel">

                <!-- Form header -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="formTitle" text="✦ Add New Film"
                           style="-fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Validation banner (hidden until needed) -->
                <Label fx:id="validationLabel" text="" wrapText="true" visible="false" managed="false"
                       style="-fx-background-color: rgba(239,68,68,0.15); -fx-text-fill: #f87171;
                              -fx-padding: 10 14; -fx-background-radius: 8; -fx-font-size: 12px;"/>

                <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                <!-- ── CORE INFO ── -->
                <Label text="FILM INFO" styleClass="admin-section-title"/>

                <TextField fx:id="titleField" promptText="Film title *"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                  -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>

                <TextField fx:id="directorField" promptText="Director"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                  -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>

                <HBox spacing="10">
                    <TextField fx:id="durationField" promptText="Duration (min)"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                      -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                    <TextField fx:id="ageRatingField" promptText="Age (16+)" prefWidth="90"
                               style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                      -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                    <TextField fx:id="ratingField" promptText="Rating (0-10)" prefWidth="110"
                               style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                      -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                </HBox>

                <DatePicker fx:id="releaseDatePicker" promptText="Release date"
                            maxWidth="1.7976931348623157E308"
                            style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                   -fx-border-color: rgba(255,255,255,0.10);
                                   -fx-border-radius: 8; -fx-background-radius: 8;"/>

                <TextArea fx:id="synopsisArea" promptText="Synopsis…"
                          prefRowCount="3" wrapText="true"
                          style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                 -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                 -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>

                <TextField fx:id="castingField" promptText="Casting (DiCaprio, Pitt…)"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                  -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>

                <!-- ── MEDIA FILES ── -->
                <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>
                <Label text="MEDIA FILES" styleClass="admin-section-title"/>

                <!-- Video -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="videoField" promptText="Video (.mp4)" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                      -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12;"/>
                    <Button text="📁" onAction="#chooseVideoFile" styleClass="admin-secondary-button"/>
                </HBox>

                <!-- Trailer -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="trailerField" promptText="Trailer (.mp4)" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                      -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12;"/>
                    <Button text="📁" onAction="#chooseTrailerFile" styleClass="admin-secondary-button"/>
                </HBox>

                <!-- Cover / background -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="coverField" promptText="Background cover image *" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                      -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12;"/>
                    <Button text="🖼" onAction="#chooseCoverFile" styleClass="admin-secondary-button"/>
                </HBox>

                <!-- Title logo image -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="titleImageField" promptText="Title logo image" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                      -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12;"/>
                    <Button text="🖼" onAction="#chooseTitleImageFile" styleClass="admin-secondary-button"/>
                </HBox>

                <!-- Poster horizontal -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="posterField" promptText="Poster horizontal" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                      -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12;"/>
                    <Button text="🖼" onAction="#choosePosterFile" styleClass="admin-secondary-button"/>
                </HBox>

                <!-- Poster vertical (poster_v_url) — was missing -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="posterVField" promptText="Poster vertical" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white;
                                      -fx-prompt-text-fill: #6b7280; -fx-border-color: rgba(255,255,255,0.10);
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12;"/>
                    <Button text="🖼" onAction="#choosePosterVFile" styleClass="admin-secondary-button"/>
                </HBox>

                <!-- ── CATEGORIES ── -->
               <!-- ── CATEGORIES ── -->
<Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>
<Label text="CATEGORIES" styleClass="admin-section-title"/>
<Label text="Click to toggle categories"
       style="-fx-text-fill: #6b7280; -fx-font-size: 11px;"/>

<FlowPane fx:id="categoryChipPane"
          hgap="8" vgap="8"
          style="-fx-background-color: rgba(255,255,255,0.03);
                 -fx-border-color: rgba(255,255,255,0.08);
                 -fx-border-radius: 8; -fx-background-radius: 8;
                 -fx-padding: 12;"/>
                <!-- ── ACTION BUTTONS ── -->
                <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                <Button fx:id="submitBtn" text="Add Film"
                        onAction="#handleSubmit"
                        maxWidth="1.7976931348623157E308"
                        styleClass="admin-primary-button"/>

                <Button fx:id="cancelEditBtn" text="✕  Cancel Edit"
                        onAction="#cancelEdit"
                        visible="false" managed="false"
                        maxWidth="1.7976931348623157E308"
                        styleClass="admin-secondary-button"/>

            </VBox>
        </ScrollPane>

        <!-- ── RIGHT PANEL – FILM GRID ──────────────── -->
        <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
              styleClass="admin-card"
              style="-fx-padding: 20 24 24 24;">

            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 0 0 18 0;">
                <Label text="All Films"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <ScrollPane fx:id="scrollPane"
                        fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;">
                <TilePane fx:id="filmsContainer"
                          hgap="18" vgap="18" prefColumns="4"
                          style="-fx-padding: 0; -fx-background-color: transparent;"/>
            </ScrollPane>
        </VBox>

    </HBox>
</VBox>
