<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.FilmAdminController"
      stylesheets="@/view/css/style.css"
      spacing="20"
      style="-fx-padding: 24; -fx-font-family: 'Segoe UI', sans-serif;">

    <Label text="🎬 Films Management (Administrator)"
           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" />

    <VBox spacing="18" style="-fx-background-color: rgba(255,255,255,0.08); -fx-padding: 24; -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.14); -fx-border-radius: 18;">
        <Label text="Add New Film" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

        <HBox spacing="10">
            <TextField fx:id="titleField" promptText="Film Title" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="durationField" promptText="Duration (min)" prefWidth="100"/>
            <TextField fx:id="ageRatingField" promptText="Age (e.g., 16+)" prefWidth="100"/>
            <DatePicker fx:id="releaseDatePicker" promptText="Release Date" prefWidth="150"/>
        </HBox>

        <HBox spacing="10">
            <TextField fx:id="synopsisField" promptText="Synopsis" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="castingField" promptText="Casting (e.g., DiCaprio, Pitt)" HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox spacing="10">
            <HBox spacing="10">
                <TextField fx:id="videoField" promptText="Video (.mp4)" HBox.hgrow="ALWAYS"/>
                <Button text="Browse" onAction="#chooseVideoFile"/>
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="coverField" promptText="Background Image (Cover)" HBox.hgrow="ALWAYS"/>
                <Button text="Browse" onAction="#chooseCoverFile"/>
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="titleImageField" promptText="Title Image (Logo)" HBox.hgrow="ALWAYS"/>
                <Button text="Browse" onAction="#chooseTitleImageFile"/>
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="posterField" promptText="Poster (Vertical Poster)" HBox.hgrow="ALWAYS"/>
                <Button text="Browse" onAction="#choosePosterFile"/>
            </HBox>
        </VBox>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label text="Categories (Ctrl for multiple selection)" style="-fx-text-fill: lightgray; -fx-font-size: 12px;"/>
                <ListView fx:id="categoryListView" prefHeight="90" prefWidth="280" style="-fx-background-color: rgba(255,255,255,0.08); -fx-control-inner-background: rgba(255,255,255,0.05); -fx-border-color: rgba(255,255,255,0.16); -fx-border-radius: 10; -fx-background-radius: 10;"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Add Film" onAction="#addFilm"
                    style="-fx-background-color: #E50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 28; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 12;"/>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-control-inner-background: transparent;" VBox.vgrow="ALWAYS">
        <TilePane fx:id="filmsContainer"
                  hgap="20"
                  vgap="20"
                  prefColumns="4"
                  style="-fx-padding: 10;"/>
    </ScrollPane>

</VBox>