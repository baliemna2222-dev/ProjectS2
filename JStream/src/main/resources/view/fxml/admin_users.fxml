<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.UsersController"
      stylesheets="@/view/css/style.css"
      spacing="25"
      styleClass="admin-root"
      style="-fx-padding: 30; -fx-background-color: transparent;">

    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="admin-page-header">
        <VBox spacing="3">
            <Label text="User Management"
                   style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
            <Label text="Manage your user accounts with the same premium admin style"
                   style="-fx-text-fill: #aacffa; -fx-font-size: 13px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Refresh" onAction="#initialize" styleClass="admin-secondary-button" />
    </HBox>

    <VBox spacing="18" styleClass="admin-card">
        <Label text="Add User"
               style="-fx-text-fill: #cbd5e1; -fx-font-size: 16px; -fx-font-weight: bold;" />
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Username" style="-fx-text-fill: #cbd5e1;" />
                <TextField fx:id="newUsernameField" promptText="Username" />
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Email" style="-fx-text-fill: #cbd5e1;" />
                <TextField fx:id="newEmailField" promptText="Email" />
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Password" style="-fx-text-fill: #cbd5e1;" />
                <TextField fx:id="newPasswordField" promptText="Password" />
            </VBox>
            <VBox spacing="6">
                <Label text="Role" style="-fx-text-fill: #cbd5e1;" />
                <ComboBox fx:id="newRoleComboBox" prefWidth="140" />
            </VBox>
            <Button fx:id="addUserButton" text="Add" onAction="#handleAddUser" styleClass="admin-primary-button" />
        </HBox>
        <Label fx:id="addUserMessage" text="" style="-fx-text-fill: #7dd3fc;" />
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox fx:id="userListContainer" spacing="15" styleClass="admin-card" style="-fx-padding: 16;" />
    </ScrollPane>

</VBox>