<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<StackPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: black;" stylesheets="@/view/css/player.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="JStream.controller.VideoPlayerController">
    
    <MediaView fx:id="mediaView" StackPane.alignment="CENTER" />
    
    <Region pickOnBounds="false" style="-fx-background-color: linear-gradient( to bottom, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.0) 18%, rgba(0,0,0,0.0) 72%, rgba(0,0,0,0.85) 100% );" />
    
    <ProgressIndicator fx:id="loadingSpinner" maxHeight="72.0" maxWidth="72.0" style="-fx-progress-color: #00d4ff;" visible="false" StackPane.alignment="CENTER" />
    <VBox pickOnBounds="false" prefHeight="720.0" prefWidth="1280.0" StackPane.alignment="TOP_LEFT">
        
        <HBox fx:id="topBar" alignment="CENTER_LEFT" prefHeight="80.0" spacing="16.0">
            <padding>
                <Insets left="36.0" right="36.0" top="4.0" />
            </padding>
            <Button fx:id="btnClose" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 28px; -fx-cursor: hand;" text="←" />
            <Label fx:id="titleLabel" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-family: 'Segoe UI Semibold'; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 8, 0, 0, 2);" text="Movie Title" />
        </HBox>
        
        <Region VBox.vgrow="ALWAYS" />
        
        <VBox fx:id="bottomControls" pickOnBounds="true" spacing="8.0">
            <padding>
                <Insets bottom="36.0" left="36.0" right="36.0" top="16.0" />
            </padding>
        <Button fx:id="btnNextEpisode"
        style="-fx-background-color: rgba(0,212,255,0.15);
               -fx-text-fill: #00d4ff; -fx-font-size: 15px; -fx-cursor: hand;
               -fx-border-color: #00d4ff; -fx-border-radius: 20;
               -fx-background-radius: 20; -fx-padding: 8 22;
               -fx-font-family: 'Segoe UI Semibold';"
        text="Next Episode  ▶▶"
        visible="false"
        managed="false"
        StackPane.alignment="BOTTOM_RIGHT">
    <StackPane.margin>
        <Insets bottom="100.0" right="40.0" />
    </StackPane.margin>
</Button>
            
            <VBox spacing="4.0">
                <Slider fx:id="seekBar" style="-fx-cursor: hand;" styleClass="jstream-slider" />
                <HBox alignment="CENTER_RIGHT">
                    <Label fx:id="timeLabel" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 13px; -fx-font-family: 'Consolas';" text="0:00 / 0:00" />
                </HBox>
            </VBox>
            
            <HBox alignment="CENTER_LEFT" spacing="0.0">
                <HBox alignment="CENTER_LEFT" spacing="4.0">
                    <Button fx:id="btnPlay" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 26px; -fx-cursor: hand;" text="⏸" />
                    <Button fx:id="btnRewind" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 20px; -fx-cursor: hand;" text="⟲₁₀" />
                    <Button fx:id="btnForward" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 20px; -fx-cursor: hand;" text="⟳₁₀" />
                    
                    <HBox alignment="CENTER" spacing="8.0">
                        <padding>
                            <Insets left="10.0" />
                        </padding>
                        <Button fx:id="btnMute" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 20px; -fx-cursor: hand;" text="🔊" />
                        <Slider fx:id="volumeSlider" prefWidth="110.0" style="-fx-cursor: hand;" styleClass="jstream-slider" value="50.0" />
                    </HBox>
                </HBox>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox alignment="CENTER_RIGHT" spacing="16.0">
                    <Button fx:id="btnMiniPlayer" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 20px; -fx-cursor: hand;" text="🗗" />
                </HBox>
            </HBox>
        </VBox>
    </VBox>
    
</StackPane>
