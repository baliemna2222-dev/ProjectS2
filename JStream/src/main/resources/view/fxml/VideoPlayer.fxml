<?xml version="1.0" encoding="UTF-8"?> 
<?import javafx.geometry.Insets?> 
<?import javafx.scene.control.Button?> 
<?import javafx.scene.control.Label?> 
<?import javafx.scene.control.ProgressIndicator?> 
<?import javafx.scene.control.Slider?> 
<?import javafx.scene.layout.HBox?> 
<?import javafx.scene.layout.Region?> 
<?import javafx.scene.layout.StackPane?> 
<?import javafx.scene.layout.VBox?> 
<?import javafx.scene.web.WebView?> 
<?import javafx.scene.media.MediaView?>
<StackPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0"
 style="-fx-background-color: black;"
  xmlns="http://javafx.com/javafx/21" 
  xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="JStream.controller.VideoPlayerController"> 
   <!-- ── Video Surface ──────────────────────────────────────────────── -->
    <MediaView fx:id="mediaView" StackPane.alignment="CENTER" />
     <!-- Cinematic vignette gradient — top + bottom bars --> 
     <Region pickOnBounds="false"
      style="-fx-background-color: linear-gradient( to bottom, rgba(0,0,0,0.75) 0%, 
      rgba(0,0,0,0.0) 18%,
       rgba(0,0,0,0.0) 72%, 
       rgba(0,0,0,0.85) 100% );" />
       <!-- ── Loading Spinner ────────────────────────────────────────────── -->
        <ProgressIndicator fx:id="loadingSpinner" maxHeight="72.0" 
        maxWidth="72.0" style="-fx-progress-color: #00d4ff;"
         visible="false" StackPane.alignment="CENTER" /> 
         <!-- ── Controls Overlay ───────────────────────────────────────────── --> 
         <VBox pickOnBounds="false" StackPane.alignment="TOP_LEFT" prefWidth="1280.0" prefHeight="720.0"> 
         <!-- Top Bar: Back + Title --> <HBox fx:id="topBar" 
         alignment="CENTER_LEFT" prefHeight="80.0" spacing="16.0"> 
         <padding><Insets left="36.0" right="36.0" top="4.0" />
         </padding> 
         <Button fx:id="btnClose" text="←" style="-fx-background-color: transparent;
          -fx-text-fill: white;
           -fx-font-size: 28px; -
           fx-cursor: hand;" /> 
           <Label fx:id="titleLabel" text="Movie Title" 
           style="-fx-text-fill: white; -fx-font-size: 22px;
            -fx-font-family: 'Segoe UI Semibold'; 
            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 8, 0, 0, 2);" /> 
            </HBox> <!-- Spacer pushes bottom controls down --> 
            <Region VBox.vgrow="ALWAYS" /> 
            <!-- Bottom Controls: Seek + buttons --> 
            <VBox fx:id="bottomControls" spacing="8.0" pickOnBounds="true"> <padding> 
            <Insets bottom="36.0" left="36.0" right="36.0" top="16.0" /> </padding> 
            <!-- Seek Bar + Time Label --> <VBox spacing="4.0"> <Slider fx:id="seekBar"
             styleClass="jstream-slider" style="-fx-cursor: hand;" /> <HBox alignment="CENTER_RIGHT"> 
             <Label fx:id="timeLabel" text="0:00 / 0:00" style="-fx-text-fill: rgba(255,255,255,0.75); 
             -fx-font-size: 13px; -fx-font-family: 'Consolas';" /> </HBox> </VBox> 
             <!-- Button Row --> <HBox alignment="CENTER_LEFT" spacing="0.0"> 
             <!-- Left cluster: Play, Rewind, Forward, Volume --> 
             <HBox alignment="CENTER_LEFT" spacing="4.0"> <Button fx:id="btnPlay" 
             text="⏸" style="-fx-background-color: transparent; -fx-text-fill: white; 
             -fx-font-size: 26px; -fx-cursor: hand;" /> <Button fx:id="btnRewind" 
             text="⟲₁₀" style="-fx-background-color: transparent; -fx-text-fill: white;
              -fx-font-size: 20px; -fx-cursor: hand;" /> <Button fx:id="btnForward" 
              text="⟳₁₀" style="-fx-background-color: transparent; -fx-text-fill: white;
               -fx-font-size: 20px; -fx-cursor: hand;" /> 
               <!-- Volume cluster --> 
               <HBox alignment="CENTER" spacing="8.0"> 
               <padding><Insets left="10.0" /></padding>
                <Button fx:id="btnMute" text="🔊" style="-fx-background-color: transparent;
                 -fx-text-fill: white; -fx-font-size: 20px; -fx-cursor: hand;" /> 
                 <Slider fx:id="volumeSlider" prefWidth="110.0" value="50.0" styleClass="jstream-slider" 
                 style="-fx-cursor: hand;" /> </HBox> </HBox>
                  <!-- Spacer -->
                   <Region HBox.hgrow="ALWAYS" />
                    <!-- Right cluster: Mini-player + Fullscreen --> 
                    <HBox alignment="CENTER_RIGHT" spacing="16.0"> 
                    <Button fx:id="btnMiniPlayer" text="🗗" style="-fx-background-color: transparent;
                     -fx-text-fill: white; -fx-font-size: 20px; -fx-cursor: hand;" /> 
                     </HBox>
                     
                      </HBox>
                       </VBox> 
                       </VBox> 
                       </StackPane>