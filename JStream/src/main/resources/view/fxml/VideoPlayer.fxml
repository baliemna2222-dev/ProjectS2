<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<StackPane fx:id="rootPane"
           prefHeight="720.0" prefWidth="1280.0"
           style="-fx-background-color: black;"
           stylesheets="@/view/css/player.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="JStream.controller.VideoPlayerController">

    <MediaView fx:id="mediaView" StackPane.alignment="CENTER"/>

    <!-- Cinematic vignette -->
    <Region mouseTransparent="true"
            style="-fx-background-color:
                linear-gradient(to bottom,
                    rgba(0,0,0,0.70) 0%,
                    rgba(0,0,0,0.00) 15%,
                    rgba(0,0,0,0.00) 68%,
                    rgba(0,0,0,0.90) 100%);"/>

    <ProgressIndicator fx:id="loadingSpinner"
                       maxHeight="68.0" maxWidth="68.0"
                       style="-fx-progress-color: #00c8f0;"
                       visible="false"
                       StackPane.alignment="CENTER"/>

    <VBox pickOnBounds="false" prefHeight="720.0" prefWidth="1280.0"
          StackPane.alignment="TOP_LEFT">

        <!-- Top bar -->
        <HBox fx:id="topBar" alignment="CENTER_LEFT" prefHeight="72.0" spacing="14.0">
            <padding><Insets left="36.0" right="36.0" top="8.0"/></padding>

            <Button fx:id="btnClose" text="←"
                    style="-fx-background-color: rgba(255,255,255,0.08);
                           -fx-text-fill: white; -fx-font-size: 18px;
                           -fx-background-radius: 50%;
                           -fx-border-color: rgba(255,255,255,0.14);
                           -fx-border-radius: 50%;
                           -fx-min-width: 38px; -fx-min-height: 38px;
                           -fx-cursor: hand;"/>

            <Label fx:id="titleLabel" text="Movie Title"
                   style="-fx-text-fill: white; -fx-font-size: 19px;
                          -fx-font-weight: bold;
                          -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.9),6,0,0,2);"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Bottom controls -->
        <VBox fx:id="bottomControls" pickOnBounds="true" spacing="8.0">
            <padding><Insets bottom="32.0" left="36.0" right="36.0" top="12.0"/></padding>

            <!-- Next-episode chip -->
            <Button fx:id="btnNextEpisode" text="▶  Next Episode"
                    visible="false" managed="false"
                    style="-fx-background-color: rgba(0,200,240,0.12);
                           -fx-text-fill: #00c8f0; -fx-font-size: 13px;
                           -fx-font-weight: bold; -fx-cursor: hand;
                           -fx-border-color: rgba(0,200,240,0.40);
                           -fx-border-radius: 20; -fx-background-radius: 20;
                           -fx-padding: 7 20;"/>

            <!-- ── Seek bar ── -->
            <VBox spacing="4.0">
                <!--
                    StackPane trick:
                    Layer 1 (bottom): seekFill — cyan Region, width set from Java
                    Layer 2 (top):    Slider   — track is semi-transparent dim rail
                                                 thumb is the cyan dot
                    Both layers share CENTER alignment so they sit on the same
                    vertical axis; the Region is mouse-transparent.
                -->
                <StackPane fx:id="seekBarWrapper" prefHeight="20.0" alignment="CENTER_LEFT">
                    <Region fx:id="seekFill"
                            prefHeight="5.0" maxHeight="5.0"
                            mouseTransparent="true"
                            style="-fx-background-color: #00c8f0;
                                   -fx-background-radius: 3px;"
                            StackPane.alignment="CENTER_LEFT"/>
                    <Slider fx:id="seekBar" styleClass="jstream-slider"
                            style="-fx-cursor: hand; -fx-background-color: transparent;"
                            StackPane.alignment="CENTER"/>
                </StackPane>

                <HBox alignment="CENTER_RIGHT">
                    <Label fx:id="timeLabel" text="0:00 / 0:00"
                           style="-fx-text-fill: rgba(255,255,255,0.45);
                                  -fx-font-size: 11px;
                                  -fx-font-family: 'Consolas';"/>
                </HBox>
            </VBox>

            <!-- ── Playback row ── -->
            <HBox alignment="CENTER_LEFT" spacing="0.0">

                <HBox alignment="CENTER_LEFT" spacing="2.0">

                    <Button fx:id="btnPlay" text="⏸"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: white; -fx-font-size: 26px;
                                   -fx-cursor: hand; -fx-padding: 4 8;"/>

                    <Button fx:id="btnRewind" text="⟲ 10"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: rgba(255,255,255,0.75);
                                   -fx-font-size: 15px; -fx-cursor: hand;
                                   -fx-padding: 4 8;"/>

                    <Button fx:id="btnForward" text="10 ⟳"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: rgba(255,255,255,0.75);
                                   -fx-font-size: 15px; -fx-cursor: hand;
                                   -fx-padding: 4 8;"/>

                    <!-- Volume -->
                    <HBox alignment="CENTER" spacing="6.0">
                        <padding><Insets left="10.0"/></padding>
                        <Button fx:id="btnMute" text="🔊"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: rgba(255,255,255,0.75);
                                       -fx-font-size: 17px; -fx-cursor: hand;
                                       -fx-padding: 4 6;"/>

                        <!-- Same StackPane pattern for volume -->
                        <StackPane fx:id="volumeSliderWrapper"
                                   prefWidth="90.0" prefHeight="20.0"
                                   alignment="CENTER_LEFT">
                            <Region fx:id="volumeFill"
                                    prefHeight="4.0" maxHeight="4.0"
                                    mouseTransparent="true"
                                    style="-fx-background-color: #00c8f0;
                                           -fx-background-radius: 3px;"
                                    StackPane.alignment="CENTER_LEFT"/>
                            <Slider fx:id="volumeSlider"
                                    prefWidth="90.0" value="62.0"
                                    styleClass="jstream-slider"
                                    style="-fx-cursor: hand; -fx-background-color: transparent;"
                                    StackPane.alignment="CENTER"/>
                        </StackPane>
                    </HBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <Button fx:id="btnMiniPlayer" text="⛶"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: rgba(255,255,255,0.6);
                                   -fx-font-size: 17px; -fx-cursor: hand;
                                   -fx-padding: 4 6;"/>
                </HBox>
            </HBox>
        </VBox>
    </VBox>
</StackPane>