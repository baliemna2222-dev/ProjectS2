<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.SeriesAdminController"
      stylesheets="@/view/css/style.css"
      spacing="20"
      style="-fx-padding: 30;">

    <Label text="Series Management" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" />

    <HBox spacing="20">
        <VBox spacing="12" style="-fx-background-color: rgba(255,255,255,0.08); -fx-padding: 24; -fx-background-radius: 16;" prefWidth="360">
            <Label text="Add Series" style="-fx-text-fill: #0ef; -fx-font-size: 16px; -fx-font-weight: bold;" />
            
            <TextField fx:id="titleField" promptText="Series Title" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            <TextField fx:id="ageRatingField" promptText="Minimum Age (e.g., 12+)" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            <TextArea fx:id="synopsisField" promptText="Synopsis" prefHeight="80" wrapText="true" style="-fx-control-inner-background: #2c3e50; -fx-text-fill: white;"/>
            <TextField fx:id="castingField" promptText="Casting (e.g., Actor 1, Actor 2)" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            
            <Separator />
            <Label text="Images" style="-fx-text-fill: gray; -fx-font-size: 12px;" />
            
            <TextField fx:id="coverField" promptText="Main Cover URL (covert_url)" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            <TextField fx:id="titleUrlField" promptText="Title Logo URL (title_url)" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            
            <Separator />
            <Label text="Categories (Ctrl/Cmd for multiple selection)" style="-fx-text-fill: gray; -fx-font-size: 12px;" />
            <ListView fx:id="categoryListView" prefHeight="100" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: rgba(255,255,255,0.12); -fx-border-radius: 10; -fx-background-radius: 10;"/>

            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 12 0 0 0;">
                <Button text="Add Series" onAction="#addSerie" style="-fx-background-color: #0ef; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 12;"/>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
            <TilePane fx:id="seriesContainer" hgap="15" vgap="15" prefColumns="4">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </TilePane>
        </ScrollPane>
    </HBox>
</VBox>