<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.SeriesAdminController"
      stylesheets="@/view/css/style.css"
      spacing="0"
      styleClass="admin-root"
      style="-fx-font-family: 'Segoe UI', sans-serif;">

    <!-- ══ TOP NAV ══════════════════════════════════════════════════════════ -->
  <HBox alignment="CENTER_LEFT" spacing="20" styleClass="admin-page-header">

        <Label text="Series  C R U D"
               style="-fx-text-fill: #8cc9ff; -fx-font-size: 22px;
                      -fx-font-weight: bold; -fx-letter-spacing: 4px;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Search -->
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-background-color: rgba(66,165,245,0.12);
                     -fx-background-radius: 24; -fx-padding: 8 16;
                     -fx-border-color: rgba(66,165,245,0.22); -fx-border-radius: 24;">
            <Label text="🔍" style="-fx-text-fill: #cfe8ff;"/>
            <TextField fx:id="searchField"
                       promptText="Search Series, director, genre, year…"
                       prefWidth="260"
                       style="-fx-background-color: transparent; -fx-text-fill: white;
                              -fx-prompt-text-fill: rgba(255,255,255,0.55); -fx-border-width: 0;"/>
        </HBox>

        <!-- Film count badge -->
        <Label fx:id="serieCountLabel" text="0 films" styleClass="admin-badge"/>
    </HBox>

    <!-- ══ BODY ═════════════════════════════════════════════════════════════ -->
    <HBox VBox.vgrow="ALWAYS" spacing="0">

        <!-- ── LEFT SIDEBAR – FORM ───────────────────────────────────────── -->
        <ScrollPane fitToWidth="true" styleClass="admin-sidebar-panel" prefWidth="355" minWidth="310">
            <VBox fx:id="formPanel" spacing="16" styleClass="admin-form-panel">

                <Label fx:id="formTitle" text="✦ Add New Series"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                <!-- Validation banner -->
                <Label fx:id="validationLabel" text="" wrapText="true"
                       style="-fx-background-color: rgba(66,165,245,0.12);
                              -fx-text-fill: #64b5f6;
                              -fx-padding: 10 14; -fx-background-radius: 8;
                              -fx-font-size: 12px;"/>

                <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>
                <Label text="SERIES INFO" styleClass="admin-section-title"/>

                <TextField fx:id="titleField"     promptText="Series title *"           styleClass="admin-form-input"/>
                <TextField fx:id="directorField"  promptText="Director"                 styleClass="admin-form-input"/>
                <TextField fx:id="ageRatingField" promptText="Age rating (e.g. 16+)"    styleClass="admin-form-input"/>
                <TextArea  fx:id="synopsisField"  promptText="Synopsis *" prefRowCount="3" wrapText="true" styleClass="admin-form-input"/>
                <TextField fx:id="castingField"   promptText="Casting (Actor A, Actor B…)" styleClass="admin-form-input"/>

                <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>
                <Label text="MEDIA" styleClass="admin-section-title"/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="coverField" promptText="Cover image path *" HBox.hgrow="ALWAYS" styleClass="admin-form-input"/>
                    <Button text="🖼" onAction="#chooseCoverFile" styleClass="admin-secondary-button" minWidth="36"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="titleUrlField" promptText="Title logo image path" HBox.hgrow="ALWAYS" styleClass="admin-form-input"/>
                    <Button text="🖼" onAction="#chooseTitleUrlFile" styleClass="admin-secondary-button" minWidth="36"/>
                </HBox>

                <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>
                <Label text="CATEGORIES" styleClass="admin-section-title"/>
                <Label text="Hold Ctrl / ⌘ to select multiple *"
                       style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11px;"/>

                <ListView fx:id="categoryListView" prefHeight="110" styleClass="admin-form-input"/>

                <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                <Button fx:id="submitBtn" text="Add Series" onAction="#handleSubmit"
                        maxWidth="1.7976931348623157E308" styleClass="admin-primary-button"/>
                <Button fx:id="cancelEditBtn" text="✕  Cancel Edit" onAction="#cancelEdit"
                        maxWidth="1.7976931348623157E308" styleClass="admin-secondary-button"/>
            </VBox>
        </ScrollPane>

        <!-- ── RIGHT PANEL – CARDS GRID ──────────────────────────────────── -->
        <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" styleClass="admin-card">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 20 28 12 28;">
                <Label text="All Series"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                </HBox>

            <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <TilePane fx:id="seriesContainer" hgap="18" vgap="18" prefColumns="4"
                          style="-fx-padding: 0 28 28 28; -fx-background-color: transparent;"/>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
