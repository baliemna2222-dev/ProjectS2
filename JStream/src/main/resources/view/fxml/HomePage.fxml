<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.media.MediaView?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="JStream.controller.HomepageController"
           stylesheets="@/view/css/scrollbar.css"
           style="-fx-background-color: black;">

    <!-- ================= SCROLLABLE CONTENT ================= -->
    <ScrollPane fx:id="mainScroll"
                fitToWidth="true"
                vbarPolicy="AS_NEEDED"
                hbarPolicy="NEVER"
                style="-fx-background: black;
                       -fx-background-color: black;
                       -fx-control-inner-background: black;
                       -fx-background-insets: 0;">
        
        <StackPane> <!-- StackPane to allow floating header -->
            
            <!-- ================= MAIN CONTENT ================= -->
            <VBox>
                
                <!-- ================= CAROUSEL ================= -->
             <StackPane fx:id="heroCarousel" prefHeight="700" prefWidth="Infinity">

    <!-- BACKGROUND IMAGE -->
    <ImageView fx:id="heroBackground"
               fitWidth="1550"
               preserveRatio="true"
               StackPane.alignment="CENTER" />

    <!-- TRAILER VIDEO (hidden initially) -->
    <MediaView fx:id="heroTrailer"
               visible="false"
               fitWidth="1550"
               preserveRatio="true"/>

    <!-- DARK + BLUE SHINY GRADIENT -->
    <Rectangle StackPane.alignment="BOTTOM_CENTER"
               height="300"
               style="-fx-fill: linear-gradient(to top,
                      rgba(0,0,0,0.95),
                      rgba(0,0,0,0.5),
                      rgba(0,60,255,0.2),
                      transparent);" />

    <!-- CONTENT -->
    <VBox spacing="15"
          alignment="BOTTOM_LEFT"
          StackPane.alignment="BOTTOM_LEFT"
          style="-fx-padding: 60;">

        <!-- TITLE IMAGE -->
        <ImageView fx:id="heroTitleImage"
                   fitWidth="400"
                   preserveRatio="true" />

        <!-- RATING + CATEGORIES -->
        <HBox spacing="15" alignment="CENTER_LEFT">

            <!-- STARS -->
            <HBox fx:id="heroStars" spacing="4"/>

            <!-- CATEGORIES -->
            <Label fx:id="heroCategories"
                   text="Action • Sci-Fi • Adventure"
                   style="-fx-text-fill:#00aaff;
                          -fx-font-size:14;
                          -fx-font-weight:bold;" />

        </HBox>

        <!-- DESCRIPTION -->
        <Label fx:id="heroDescription"
               wrapText="true"
               maxWidth="550"
               style="-fx-text-fill:#dddddd;
                      -fx-font-size:16;" />

        <!-- BUTTONS -->
        <HBox spacing="15">

            <Button fx:id="playButton"
                    text="▶ Play"
                    style="-fx-background-color:#008cff;
                           -fx-text-fill:white;
                           -fx-font-size:16;
                           -fx-font-weight:bold;
                           -fx-background-radius:0;
                           -fx-padding:8 25;
                           -fx-effect:dropshadow(gaussian,#00aaff,15,0.6,0,0);" />

            <Button fx:id="infoButton"
                    text="ⓘ More Info"
                    style="-fx-background-color:rgba(50,50,60,0.7);
                           -fx-text-fill:white;
                           -fx-font-size:16;
                           -fx-font-weight:bold;
                           -fx-background-radius:6;
                           -fx-padding:8 25;" />

            <!-- TRAILER BUTTON -->
            <Button fx:id="trailerButton"
                    text="🎬 Trailer"
                   
                    style="-fx-background-color:transparent;
                           -fx-border-color:#00aaff;
                           -fx-border-radius:1;
                           -fx-text-fill:#00aaff;
                           -fx-font-size:16;
                           -fx-padding:8 20;" />

        </HBox>

    </VBox>

    <!-- SLIDE INDICATORS -->
    <HBox fx:id="heroIndicators"
          alignment="BOTTOM_CENTER"
          spacing="10"
          StackPane.alignment="BOTTOM_CENTER"
          style="-fx-padding:0 0 20 0;" />

</StackPane>
                <!-- ================= MOVIE CATEGORY ================= -->
                <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: black;">
                    <VBox spacing="10">
                        <Label fx:id="comedyLabel" text="COMEDY" 
                               style="-fx-font-weight: 900; -fx-font-size: 30px; -fx-text-fill: linear-gradient(to right,#00c6ff,#0072ff,#00f0ff);"/>
                        <ScrollPane fx:id="comedyScroll" hbarPolicy="NEVER" vbarPolicy="NEVER" fitToHeight="true" style="-fx-background-color: black;">
                            <HBox fx:id="comedyCarousel" spacing="15" style="-fx-background-color:black;"/>
                        </ScrollPane>
                    </VBox>
                </VBox>

            </VBox>
            
            <!-- ================= FLOATING HEADER ================= -->
            <HBox fx:id="header"
                  alignment="CENTER_LEFT"
                  maxHeight="80"
                  spacing="20"
                  StackPane.alignment="TOP_LEFT"
                  style="-fx-background-color: rgba(0,0,0,0.1);
                         -fx-padding: 10 50 10 50;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 10,0,0,2);
                         -fx-pref-width: 98%;">

                <!-- LOGO -->
                <ImageView fx:id="logoImage" fitHeight="100" fitWidth="150" preserveRatio="true"/>
                <Region HBox.hgrow="ALWAYS"/>

                <!-- CENTER MENU -->
            <HBox fx:id="buttonsBox" alignment="CENTER" spacing="35">

    <VBox alignment="CENTER" spacing="3">
        <Button fx:id="btnHome" text="Home" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-text-fill: #cccccc; -fx-font-size: 16;"/>
        <Rectangle fx:id="lineHome" height="2" fill="blue" width="0"/>
    </VBox>

    <VBox alignment="CENTER" spacing="3">
        <Button fx:id="btnMovies" text="Movies" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-text-fill: #cccccc; -fx-font-size: 16;"/>
        <Rectangle fx:id="lineMovies" height="2" fill="blue" width="0"/>
    </VBox>

    <VBox alignment="CENTER" spacing="3">
        <Button fx:id="btnSeries" text="Series" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-text-fill: #cccccc; -fx-font-size: 16;"/>
        <Rectangle fx:id="lineSeries" height="2" fill="blue" width="0"/>
    </VBox>

    <VBox alignment="CENTER" spacing="3">
        <Button fx:id="btnTvShows" text="TV Shows" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-text-fill: #cccccc; -fx-font-size: 16;"/>
        <Rectangle fx:id="lineTvShows" height="2" fill="blue" width="0"/>
    </VBox>

    <VBox alignment="CENTER" spacing="3">
        <Button fx:id="btnMyList" text="My List" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-text-fill: #cccccc; -fx-font-size: 16;"/>
        <Rectangle fx:id="lineMyList" height="2" fill="blue" width="0"/>
    </VBox>

</HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- RIGHT ICONS -->
                <HBox alignment="CENTER_RIGHT" spacing="15">
                <StackPane alignment="CENTER_RIGHT">

    <HBox fx:id="searchBox" alignment="CENTER_RIGHT" spacing="5">

        <TextField fx:id="searchInput"
                   promptText="Type to search..."
                   prefWidth="0"
                   styleClass="input-search"/>

        <Button fx:id="btnResearch"
                onAction="#toggleSearch"
                prefWidth="40"
                prefHeight="40"
                styleClass="btn-search"/>
		 
		
    </HBox>

</StackPane>
   <Button fx:id="btnNotification" style="-fx-background-color: transparent;">
                        <graphic>
                            <StackPane fx:id="bellContainer">
                                <ImageView fx:id="bellIcon" fitWidth="22" fitHeight="22"/>
                                <Circle fx:id="notificationCircle" radius="2" fill="#f72918" stroke="#ffffff" strokeWidth="0.5" translateX="6" translateY="-6" visible="false"/>
                            </StackPane>
                        </graphic>
                    </Button>
                    <Button fx:id="profile" prefWidth="36" prefHeight="36" style="-fx-background-color: transparent; -fx-background-image: url('/assets/images/profile.png'); -fx-background-repeat: no-repeat; -fx-background-position: center; -fx-background-size: 34 34;"/>
                </HBox>

            </HBox>

        </StackPane>
    </ScrollPane>

</StackPane>