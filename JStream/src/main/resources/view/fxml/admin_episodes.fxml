<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.EpisodesAdminController"
      stylesheets="@/view/css/style.css"
      spacing="20"
      style="-fx-padding: 30;">
    <HBox spacing="20" alignment="CENTER_LEFT">
        <Button text="Back" onAction="#retourSaisons" style="-fx-background-color: #444; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 10;"/>
        <Label fx:id="seasonInfoLabel" text="Add Episode" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" />
    </HBox>

    <HBox spacing="30" VBox.vgrow="ALWAYS">
        <VBox spacing="15" style="-fx-background-color: rgba(255,255,255,0.08); -fx-padding: 22; -fx-background-radius: 14;" prefWidth="520">
            <Label text="Add Episode" style="-fx-text-fill: #0ef; -fx-font-size: 16px; -fx-font-weight: bold;" />
            <HBox spacing="10">
                <TextField fx:id="seasonIdField" promptText="Season ID" HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-text-fill: white;" editable="false"/>
                <TextField fx:id="numEpisodeField" promptText="Episode Number" HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            </HBox>
            <TextField fx:id="titleField" promptText="Episode Title" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            <HBox spacing="10">
                <TextField fx:id="durationField" promptText="Duration (min)" HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
                <TextField fx:id="ratingField" promptText="Rating (0-5)" HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            </HBox>
            <TextArea fx:id="resumeField" promptText="Summary" prefHeight="80" wrapText="true" style="-fx-control-inner-background: #2c3e50; -fx-text-fill: white;"/>
            <TextField fx:id="videoUrlField" promptText="Video URL" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            <TextField fx:id="covertUrlField" promptText="Thumbnail URL" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            <DatePicker fx:id="releasedAtPicker" promptText="Air Date" prefWidth="600" style="-fx-control-inner-background: #2c3e50;"/>
            <Button text="Add Episode" onAction="#handleAddEpisode" maxWidth="Infinity" style="-fx-background-color: #0ef; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>

        <VBox spacing="15" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.08); -fx-padding: 22; -fx-background-radius: 14;">
            <Label text="Existing Episodes" style="-fx-text-fill: #0ef; -fx-font-size: 16px; -fx-font-weight: bold;" />
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="episodeListContainer" spacing="10" style="-fx-padding: 10;" />
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
