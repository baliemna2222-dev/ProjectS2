<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.SeasonsAdminController"
      spacing="0"
      stylesheets="@/view/css/style.css"
      style="-fx-background-color: #03060f; -fx-font-family: 'Segoe UI', sans-serif;">

    <!-- ══ LEFT SIDEBAR – FORM ══════════════════════════════════════════════ -->
    <ScrollPane fitToWidth="true"
                style="-fx-background: #080d1a; -fx-background-color: #080d1a;
                       -fx-border-color: rgba(29,78,216,0.18); -fx-border-width: 0 1 0 0;"
                prefWidth="370" minWidth="330">

        <VBox fx:id="formPanel" spacing="14"
              style="-fx-padding: 24 22; -fx-background-color: #080d1a;">

            <!-- Back -->
            <Button text="← Back to Series" onAction="#retourSeries"
                    style="-fx-background-color: rgba(29,78,216,0.12);
                           -fx-text-fill: #60a5fa; -fx-font-size: 12px;
                           -fx-padding: 7 14; -fx-background-radius: 20;
                           -fx-cursor: hand; -fx-border-color: rgba(29,78,216,0.30);
                           -fx-border-radius: 20;"/>

            <!-- Breadcrumb -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="SERIES" style="-fx-text-fill: #4b5563; -fx-font-size: 11px;"/>
                <Label text="›"      style="-fx-text-fill: #374151;"/>
                <Label fx:id="titreSerieLabel" text="—"
                       style="-fx-text-fill: #60a5fa; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="formTitleLabel" text="✦ Add Season"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

            <!-- Validation -->
            <Label fx:id="validationLabel" text="" wrapText="true"
                   style="-fx-background-color: rgba(239,68,68,0.12);
                          -fx-text-fill: #f87171; -fx-padding: 10 14;
                          -fx-background-radius: 8; -fx-font-size: 12px;"/>

            <Separator style="-fx-background-color: rgba(29,78,216,0.20);"/>
            <Label text="SEASON INFO"
                   style="-fx-text-fill: #3b82f6; -fx-font-size: 10px; -fx-font-weight: bold; -fx-letter-spacing: 2;"/>

            <HBox spacing="10">
                <TextField fx:id="seasonNumField" promptText="Season # *" prefWidth="90"
                           style="-fx-background-color: rgba(29,78,216,0.08); -fx-text-fill: white;
                                  -fx-prompt-text-fill: #4b5563; -fx-border-color: rgba(29,78,216,0.25);
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12;"/>
                <TextField fx:id="plannedEpisodesField" promptText="Planned episodes" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: rgba(29,78,216,0.08); -fx-text-fill: white;
                                  -fx-prompt-text-fill: #4b5563; -fx-border-color: rgba(29,78,216,0.25);
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12;"/>
            </HBox>

            <TextField fx:id="titleField" promptText="Season title"
                       style="-fx-background-color: rgba(29,78,216,0.08); -fx-text-fill: white;
                              -fx-prompt-text-fill: #4b5563; -fx-border-color: rgba(29,78,216,0.25);
                              -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>

            <TextArea fx:id="synopsisField" promptText="Synopsis…" prefRowCount="3" wrapText="true"
                      style="-fx-background-color: rgba(29,78,216,0.08); -fx-text-fill: white;
                             -fx-prompt-text-fill: #4b5563; -fx-border-color: rgba(29,78,216,0.25);
                             -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;"/>

            <HBox spacing="10">
                <ComboBox fx:id="statusComboBox" promptText="Status" HBox.hgrow="ALWAYS"
                          maxWidth="1.7976931348623157E308"
                          style="-fx-background-color: rgba(29,78,216,0.08);
                                 -fx-border-color: rgba(29,78,216,0.25);
                                 -fx-border-radius: 8; -fx-background-radius: 8;"/>
                <TextField fx:id="ratingField" promptText="Rating (1-5)" prefWidth="100"
                           style="-fx-background-color: rgba(29,78,216,0.08); -fx-text-fill: white;
                                  -fx-prompt-text-fill: #4b5563; -fx-border-color: rgba(29,78,216,0.25);
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12;"/>
            </HBox>

            <Separator style="-fx-background-color: rgba(29,78,216,0.20);"/>
            <Label text="MEDIA"
                   style="-fx-text-fill: #3b82f6; -fx-font-size: 10px; -fx-font-weight: bold; -fx-letter-spacing: 2;"/>

            <!-- Trailer – video chooser -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="trailerUrlField" promptText="Trailer video" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: rgba(29,78,216,0.08); -fx-text-fill: white;
                                  -fx-prompt-text-fill: #4b5563; -fx-border-color: rgba(29,78,216,0.25);
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12;"/>
                <Button text="🎬" onAction="#chooseTrailerFile"
                        style="-fx-background-color: rgba(29,78,216,0.18); -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand;" minWidth="36"/>
            </HBox>

            <!-- Poster – image chooser -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="posterUrlField" promptText="Poster image" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: rgba(29,78,216,0.08); -fx-text-fill: white;
                                  -fx-prompt-text-fill: #4b5563; -fx-border-color: rgba(29,78,216,0.25);
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12;"/>
                <Button text="🖼" onAction="#choosePosterFile"
                        style="-fx-background-color: rgba(29,78,216,0.18); -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand;" minWidth="36"/>
            </HBox>

            <!-- Title logo – image chooser -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="titleUrlField" promptText="Title logo image" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: rgba(29,78,216,0.08); -fx-text-fill: white;
                                  -fx-prompt-text-fill: #4b5563; -fx-border-color: rgba(29,78,216,0.25);
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12;"/>
                <Button text="🖼" onAction="#chooseTitleUrlFile"
                        style="-fx-background-color: rgba(29,78,216,0.18); -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand;" minWidth="36"/>
            </HBox>

            <!-- General image – image chooser -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="imageUrlField" promptText="General image" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: rgba(29,78,216,0.08); -fx-text-fill: white;
                                  -fx-prompt-text-fill: #4b5563; -fx-border-color: rgba(29,78,216,0.25);
                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12;"/>
                <Button text="🖼" onAction="#chooseImageFile"
                        style="-fx-background-color: rgba(29,78,216,0.18); -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand;" minWidth="36"/>
            </HBox>

            <Separator style="-fx-background-color: rgba(29,78,216,0.20);"/>

            <Button fx:id="submitBtn" text="Add Season" onAction="#handleAddSeason"
                    maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: linear-gradient(to right, #1d4ed8, #0ea5e9);
                           -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-font-size: 14px; -fx-padding: 13 0;
                           -fx-background-radius: 10; -fx-cursor: hand;"/>

            <Button fx:id="cancelEditBtn" text="✕  Cancel Edit" onAction="#cancelEdit"
                    maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: rgba(255,255,255,0.06);
                           -fx-text-fill: #6b7280; -fx-font-size: 13px;
                           -fx-padding: 10 0; -fx-background-radius: 10; -fx-cursor: hand;"/>
        </VBox>
    </ScrollPane>

    <!-- ══ RIGHT PANEL – SEASONS LIST ════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS" spacing="0"
          style="-fx-background-color: #03060f;">

        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-padding: 24 28 16 28;
                     -fx-border-color: rgba(29,78,216,0.12); -fx-border-width: 0 0 1 0;">
            <VBox spacing="2">
                <Label text="Seasons"
                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label fx:id="seasonCountLabel" text="0 seasons"
                       style="-fx-text-fill: #4b5563; -fx-font-size: 12px;"/>
            </VBox>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox fx:id="seasonsListContainer" spacing="14"
                  style="-fx-padding: 22 28; -fx-background-color: transparent;"/>
        </ScrollPane>
    </VBox>

</HBox>
