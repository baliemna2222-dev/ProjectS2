<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.SeasonsAdminController"
      stylesheets="@/view/css/style.css">
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button text="← Back to Series" onAction="#retourSeries" style="-fx-background-color: #444; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 10;"/>
        <Label fx:id="titreSerieLabel" text="Seasons Management" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" />
    </HBox>

    <HBox spacing="30" VBox.vgrow="ALWAYS">
        <VBox spacing="15" style="-fx-background-color: #ffffff1a; -fx-padding: 20; -fx-background-radius: 10;" prefWidth="400">
            <Label text="Add Season" style="-fx-text-fill: #0ef; -fx-font-size: 16px; -fx-font-weight: bold;" />
            
            <HBox spacing="10">
                <TextField fx:id="seasonNumField" promptText="Season # (e.g., 1)" HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
                <TextField fx:id="plannedEpisodesField" promptText="Planned Episodes" HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
                <TextField fx:id="ratingField" promptText="Rating (0-5)" HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            </HBox>
            
            <TextField fx:id="titleField" promptText="Season Title (optional)" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            <TextArea fx:id="synopsisField" promptText="Season Synopsis" prefHeight="80" wrapText="true" style="-fx-control-inner-background: #2c3e50; -fx-text-fill: white;"/>
            
            <TextField fx:id="trailerUrlField" promptText="Trailer URL" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            <TextField fx:id="posterUrlField" promptText="Poster URL" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            <TextField fx:id="titleUrlField" promptText="Title Logo URL" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            <TextField fx:id="imageUrlField" promptText="General Image URL" style="-fx-background-color: #2c3e50; -fx-text-fill: white;"/>
            
            <ComboBox fx:id="statusComboBox" promptText="Status" prefWidth="400" style="-fx-background-color: #2c3e50;"/>

            <Button text="Add Season" onAction="#handleAddSeason" maxWidth="Infinity" style="-fx-background-color: #0ef; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>

        <VBox spacing="10" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff1a; -fx-padding: 20; -fx-background-radius: 10;">
            <Label text="Existing Seasons" style="-fx-text-fill: #0ef; -fx-font-size: 16px; -fx-font-weight: bold;" />
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="seasonsListContainer" spacing="10">
                    </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>