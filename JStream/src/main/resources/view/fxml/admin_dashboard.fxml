<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="JStream.controller.DashboardController"
            stylesheets="@/view/css/style.css">

    <top>
        <Label text="Admin Dashboard"
               style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold; -fx-padding: 20 20 5 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 5, 0, 2, 2);" />
    </top>

    <center>
        <VBox spacing="35" style="-fx-padding: 15 30 30 30;">

            <HBox spacing="20">

                <VBox style="-fx-background-color: linear-gradient(to bottom right, #2b323c, #1e2329);
                             -fx-padding: 25;
                             -fx-background-radius: 15;
                             -fx-pref-width: 180;
                             -fx-alignment: center;
                             -fx-border-color: #ffffff1a;
                             -fx-border-radius: 15;
                             -fx-border-width: 1;">
                    <effect>
                        <DropShadow color="#00000080" radius="10" offsetY="6" offsetX="0"/>
                    </effect>
                    <Label text="USERS" style="-fx-text-fill: #00d2ff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;"/>
                    <Label fx:id="totalUsersLabel"
                           text="0"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 34px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <VBox style="-fx-background-color: linear-gradient(to bottom right, #2b323c, #1e2329);
                             -fx-padding: 25;
                             -fx-background-radius: 15;
                             -fx-pref-width: 180;
                             -fx-alignment: center;
                             -fx-border-color: #ffffff1a;
                             -fx-border-radius: 15;
                             -fx-border-width: 1;">
                    <effect>
                        <DropShadow color="#00000080" radius="10" offsetY="6" offsetX="0"/>
                    </effect>
                    <Label text="FILMS" style="-fx-text-fill: #3a7bd5; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;"/>
                    <Label fx:id="totalFilmsLabel"
                           text="0"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 34px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <VBox style="-fx-background-color: linear-gradient(to bottom right, #2b323c, #1e2329);
                             -fx-padding: 25;
                             -fx-background-radius: 15;
                             -fx-pref-width: 180;
                             -fx-alignment: center;
                             -fx-border-color: #ffffff1a;
                             -fx-border-radius: 15;
                             -fx-border-width: 1;">
                    <effect>
                        <DropShadow color="#00000080" radius="10" offsetY="6" offsetX="0"/>
                    </effect>
                    <Label text="SERIES" style="-fx-text-fill: #f5af19; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;"/>
                    <Label fx:id="totalSeriesLabel"
                           text="0"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 34px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <VBox style="-fx-background-color: linear-gradient(to bottom right, #2b323c, #1e2329);
                             -fx-padding: 25;
                             -fx-background-radius: 15;
                             -fx-pref-width: 180;
                             -fx-alignment: center;
                             -fx-border-color: #ffffff1a;
                             -fx-border-radius: 15;
                             -fx-border-width: 1;">
                    <effect>
                        <DropShadow color="#00000080" radius="10" offsetY="6" offsetX="0"/>
                    </effect>
                    <Label text="COMMENTS" style="-fx-text-fill: #f97316; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;"/>
                    <Label fx:id="totalCommentsLabel"
                           text="0"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 34px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <VBox style="-fx-background-color: linear-gradient(to bottom right, #2b323c, #1e2329);
                             -fx-padding: 25;
                             -fx-background-radius: 15;
                             -fx-pref-width: 180;
                             -fx-alignment: center;
                             -fx-border-color: #ffffff1a;
                             -fx-border-radius: 15;
                             -fx-border-width: 1;">
                    <effect>
                        <DropShadow color="#00000080" radius="10" offsetY="6" offsetX="0"/>
                    </effect>
                    <Label text="WATCH SESSIONS" style="-fx-text-fill: #76e4f7; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;"/>
                    <Label fx:id="totalWatchSessionsLabel"
                           text="0"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 34px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <VBox style="-fx-background-color: linear-gradient(to bottom right, #2b323c, #1e2329);
                             -fx-padding: 25;
                             -fx-background-radius: 15;
                             -fx-pref-width: 180;
                             -fx-alignment: center;
                             -fx-border-color: #ffffff1a;
                             -fx-border-radius: 15;
                             -fx-border-width: 1;">
                    <effect>
                        <DropShadow color="#00000080" radius="10" offsetY="6" offsetX="0"/>
                    </effect>
                    <Label text="ACTIVE VIEWERS" style="-fx-text-fill: #d946ef; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;"/>
                    <Label fx:id="totalActiveViewersLabel"
                           text="0"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 34px;
                                  -fx-font-weight: bold;"/>
                </VBox>

            </HBox>

            <HBox spacing="30" VBox.vgrow="ALWAYS">
                <VBox spacing="10" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 20;">
                    <Label text="Most Watched Films"
                           style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
                    <TableView fx:id="topFilmsTable"
                               style="-fx-background-color: transparent; 
                                      -fx-border-color: #ffffff33; 
                                      -fx-border-radius: 8; 
                                      -fx-background-radius: 8;"
                               VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="filmTitleColumn"
                                         text="Film"
                                         prefWidth="360"
                                         style="-fx-alignment: CENTER-LEFT;"/>
                            <TableColumn fx:id="filmViewsColumn"
                                         text="Views"
                                         prefWidth="120"
                                         style="-fx-alignment: CENTER;"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 20;">
                    <Label text="Most Watched Series"
                           style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
                    <TableView fx:id="topSeriesTable"
                               style="-fx-background-color: transparent; 
                                      -fx-border-color: #ffffff33; 
                                      -fx-border-radius: 8; 
                                      -fx-background-radius: 8;"
                               VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="seriesTitleColumn"
                                         text="Series"
                                         prefWidth="360"
                                         style="-fx-alignment: CENTER-LEFT;"/>
                            <TableColumn fx:id="seriesViewsColumn"
                                         text="Views"
                                         prefWidth="120"
                                         style="-fx-alignment: CENTER;"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>

            <HBox spacing="30" VBox.vgrow="ALWAYS">
                <VBox spacing="10" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 20;">
                    <Label text="Film Distribution by Category" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
                    <PieChart fx:id="categoryPieChart" prefHeight="320" prefWidth="360" />
                </VBox>

                <VBox spacing="10" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 20;">
                    <Label text="Top 5 Most Watched Films" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
                    <BarChart fx:id="topFilmsBarChart" prefHeight="320" prefWidth="360" legendVisible="false">
                        <xAxis>
                            <CategoryAxis fx:id="filmsCategoryAxis" label="Film" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="filmsNumberAxis" label="Views" />
                        </yAxis>
                    </BarChart>
                </VBox>

                <VBox spacing="10" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 20;">
                    <Label text="Daily Signups" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
                    <LineChart fx:id="signupLineChart" prefHeight="320" prefWidth="360" legendVisible="false">
                        <xAxis>
                            <CategoryAxis fx:id="signupDateAxis" label="Date" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="signupCountAxis" label="Signups" />
                        </yAxis>
                    </LineChart>
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>