<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="JStream.controller.LecturePageController"
           prefWidth="1280" prefHeight="800"
           stylesheets="@/view/css/scrollbar.css"
           style="-fx-background-color: #02040a;">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  BACKGROUND LAYER STACK                                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Blurred hero image -->
    <ImageView fx:id="backgroundImage"
               fitWidth="1280" fitHeight="680"
               preserveRatio="false"
               opacity="0.22"
               StackPane.alignment="TOP_CENTER">
        <effect>
            <GaussianBlur radius="22"/>
        </effect>
    </ImageView>

    <!-- Vignette: left cinematic fade -->
    <Region prefWidth="1280" prefHeight="680"
            StackPane.alignment="TOP_LEFT"
            style="-fx-background-color: linear-gradient(to right, #02040a 0%, rgba(2,4,10,0.75) 40%, transparent 75%);"/>

    <!-- Vignette: bottom fade into content -->
    <Region prefWidth="1280" prefHeight="680"
            StackPane.alignment="TOP_LEFT"
            style="-fx-background-color: linear-gradient(to bottom, transparent 30%, rgba(2,4,10,0.7) 70%, #02040a 100%);"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  MAIN SCROLL CONTAINER                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <ScrollPane fx:id="mainScrollPane" fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                style="-fx-background: transparent; -fx-background-color: transparent; -fx-background-insets: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;">

        <VBox fx:id="mainContainer" spacing="0">

            <!-- ─────────────────────────────────────────────────────── -->
            <!--  NAVBAR                                                  -->
            <!-- ─────────────────────────────────────────────────────── -->
            <HBox fx:id="navbar" alignment="CENTER_LEFT" prefHeight="68" spacing="28"
                  style="-fx-background-color: rgba(2,4,10,0.92);
                         -fx-padding: 0 44 0 32;
                         -fx-border-color: rgba(0,212,255,0.08);
                         -fx-border-width: 0 0 1 0;">

                <!-- Back button -->
                <Button fx:id="btnBack" text="← Back"
                        style="-fx-background-color: rgba(0,212,255,0.08);
                               -fx-text-fill: #00d4ff;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;
                               -fx-padding: 7 18;
                               -fx-cursor: hand;
                               -fx-border-color: rgba(0,212,255,0.25);
                               -fx-border-radius: 20;"/>

                <!-- Logo -->
                <ImageView fx:id="logoNav" fitHeight="32" preserveRatio="true"/>

                <!-- Nav links -->
                <HBox alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
                    <Button fx:id="btnMostWatched" text="Most Watched"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #6a7090;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;"/>
                    <Button fx:id="btnMyList" text="My List"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #6a7090;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Bell -->
                <Button fx:id="btnNotification"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4;">
                    <graphic>
                        <StackPane fx:id="bellContainer">
                            <ImageView fx:id="bellIcon" fitWidth="22" fitHeight="22" preserveRatio="true"/>
                            <Circle fx:id="notificationCircle" radius="4" fill="#00d4ff"
                                    translateX="9" translateY="-9" visible="false">
                                <effect><Bloom threshold="0.1"/></effect>
                            </Circle>
                        </StackPane>
                    </graphic>
                </Button>
            </HBox>

            <!-- ─────────────────────────────────────────────────────── -->
            <!--  HERO SECTION                                            -->
            <!-- ─────────────────────────────────────────────────────── -->
            <HBox spacing="52" style="-fx-padding: 52 64 40 56;" alignment="TOP_LEFT">

                <!-- Poster -->
                <VBox alignment="TOP_CENTER" spacing="0">
                    <ImageView fx:id="posterImage"
                               fitWidth="260" fitHeight="390"
                               preserveRatio="true"
                               style="-fx-cursor: hand; -fx-background-radius: 14;">
                        <effect>
                            <DropShadow color="rgba(0,212,255,0.35)" radius="45" spread="0.08"/>
                        </effect>
                    </ImageView>
                </VBox>

                <!-- Info column -->
                <VBox spacing="14" HBox.hgrow="ALWAYS" alignment="TOP_LEFT">

                    <!-- Title + Score row -->
                    <HBox alignment="BOTTOM_LEFT" spacing="16">
                        <Label fx:id="titleLabel" text="Movie Title"
                               style="-fx-font-size: 40px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: white;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 12, 0, 0, 2);"/>
                        <VBox alignment="CENTER" spacing="1"
                              style="-fx-background-color: rgba(0,212,255,0.12);
                                     -fx-background-radius: 10;
                                     -fx-padding: 4 12;
                                     -fx-border-color: rgba(0,212,255,0.3);
                                     -fx-border-radius: 10;">
                            <Label fx:id="scoreLabel" text="9.0"
                                   style="-fx-font-size: 22px;
                                          -fx-text-fill: #00d4ff;
                                          -fx-font-weight: bold;"/>
                            <Label text="/ 10"
                                   style="-fx-font-size: 10px; -fx-text-fill: #4e5670;"/>
                        </VBox>
                    </HBox>

                    <!-- Display stars -->
                    <HBox fx:id="starsBox" spacing="4" alignment="CENTER_LEFT"/>

                    <!-- Meta pills row -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="yearLabel" text="2024"
                               style="-fx-text-fill: #6a7090; -fx-font-size: 13px;"/>
                        <Label text="•" style="-fx-text-fill: #2a3140;"/>
                        <Label fx:id="durationLabel" text="120 min"
                               style="-fx-text-fill: #6a7090; -fx-font-size: 13px;"/>
                        <Label text="•" style="-fx-text-fill: #2a3140;"/>
                        <Label fx:id="ageRatingLabel" text="16+"
                               style="-fx-background-color: rgba(0,212,255,0.1);
                                      -fx-border-color: rgba(0,212,255,0.4);
                                      -fx-border-radius: 5;
                                      -fx-background-radius: 5;
                                      -fx-text-fill: #00d4ff;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;
                                      -fx-padding: 2 8;"/>
                        <Label fx:id="categoriesLabel" text="Action • Sci-Fi"
                               style="-fx-text-fill: #00d4ff;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 13px;"/>
                        <Label fx:id="episodeInfoLabel" text="S1 · E1"
                               style="-fx-background-color: rgba(0,212,255,0.15);
                                      -fx-background-radius: 6;
                                      -fx-text-fill: #00d4ff;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 13px;
                                      -fx-padding: 3 10;"
                               visible="false"/>
                    </HBox>

                    <!-- Tab bar -->
                    <HBox spacing="32" style="-fx-padding: 8 0 0 0;">
                        <VBox alignment="CENTER" spacing="5">
                            <Button fx:id="tabOverview" text="OVERVIEW"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: white;
                                           -fx-font-size: 12px;
                                           -fx-font-weight: bold;
                                           -fx-letter-spacing: 1.5;
                                           -fx-cursor: hand;
                                           -fx-padding: 4 0;"/>
                            <Rectangle fx:id="lineOverview" height="2" width="72" fill="#00d4ff" arcWidth="2" arcHeight="2">
                                <effect><Bloom threshold="0.2"/></effect>
                            </Rectangle>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5">
                            <Button fx:id="tabTrailers" text="TRAILERS"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #4e5670;
                                           -fx-font-size: 12px;
                                           -fx-font-weight: bold;
                                           -fx-letter-spacing: 1.5;
                                           -fx-cursor: hand;
                                           -fx-padding: 4 0;"/>
                            <Rectangle fx:id="lineTrailers" height="2" width="68" fill="#00d4ff" arcWidth="2" arcHeight="2" visible="false"/>
                        </VBox>
                    </HBox>

                    <!-- Description -->
                    <Label fx:id="descriptionLabel" wrapText="true" prefWidth="680" maxWidth="680"
                           style="-fx-text-fill: #8a92aa;
                                  -fx-font-size: 14.5px;
                                  -fx-line-spacing: 6;"/>

                    <!-- Cast / Director -->
                    <VBox spacing="7" style="-fx-padding: 4 0 0 0;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Starring"
                                   style="-fx-text-fill: #3e4560;
                                          -fx-font-size: 12px;
                                          -fx-font-weight: bold;
                                          -fx-min-width: 64;"/>
                            <Label fx:id="starringLabel" text="—"
                                   style="-fx-text-fill: #c0c8d8; -fx-font-size: 13px;"/>
                        </HBox>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Director"
                                   style="-fx-text-fill: #3e4560;
                                          -fx-font-size: 12px;
                                          -fx-font-weight: bold;
                                          -fx-min-width: 64;"/>
                            <Label fx:id="directorLabel" text="—"
                                   style="-fx-text-fill: #c0c8d8; -fx-font-size: 13px;"/>
                        </HBox>
                    </VBox>

                    <!-- CTA Buttons -->
                    <HBox spacing="14" style="-fx-padding: 12 0 0 0;" alignment="CENTER_LEFT">
                        <Button fx:id="playButton" text="▶  Watch Now"
                                prefHeight="48" prefWidth="180"
                                style="-fx-background-color: linear-gradient(to right, #00d4ff 0%, #0080e0 100%);
                                       -fx-text-fill: #02040a;
                                       -fx-font-size: 15px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 28;
                                       -fx-cursor: hand;">
                            <effect>
                                <DropShadow color="rgba(0,212,255,0.55)" radius="22" spread="0.15"/>
                            </effect>
                        </Button>

                        <Button fx:id="addToListButton" text="+ My List"
                                prefHeight="48" prefWidth="130"
                                style="-fx-background-color: rgba(255,255,255,0.07);
                                       -fx-text-fill: white;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 28;
                                       -fx-border-color: rgba(255,255,255,0.18);
                                       -fx-border-radius: 28;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- ─────────────────────────────────────────────────────── -->
            <!--  CAST & CREW                                             -->
            <!-- ─────────────────────────────────────────────────────── -->
            <VBox spacing="20"
                  style="-fx-padding: 32 64 36 64;
                         -fx-background-color: rgba(0,212,255,0.03);
                         -fx-border-color: rgba(0,212,255,0.07) transparent rgba(0,212,255,0.07) transparent;
                         -fx-border-width: 1 0 1 0;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Rectangle width="3" height="22" fill="#00d4ff" arcWidth="3" arcHeight="3"/>
                    <Label text="Cast &amp; Crew"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                </HBox>
                <HBox fx:id="castBox" spacing="28" alignment="CENTER_LEFT"/>
            </VBox>

            <!-- ─────────────────────────────────────────────────────── -->
            <!--  REVIEWS SECTION                                         -->
            <!-- ─────────────────────────────────────────────────────── -->
            <VBox spacing="0" style="-fx-padding: 48 64 64 64; -fx-background-color: transparent;">

                <!-- Section header -->
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 28 0;">
                    <Rectangle width="3" height="22" fill="#00d4ff" arcWidth="3" arcHeight="3"/>
                    <Label text="Reviews"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                </HBox>

                <HBox spacing="44" alignment="TOP_LEFT">

                    <!-- ── Comment cards carousel ── -->
                    <VBox spacing="16" HBox.hgrow="ALWAYS">
                        <HBox fx:id="commentsContainer" spacing="16" alignment="CENTER_LEFT"
                              style="-fx-padding: 4 0 8 0;"/>
                    </VBox>

                    <!-- ── Write-a-review panel ── -->
                    <VBox spacing="18" prefWidth="370" minWidth="340"
                          style="-fx-background-color: rgba(255,255,255,0.025);
                                 -fx-background-radius: 18;
                                 -fx-border-color: rgba(0,212,255,0.12);
                                 -fx-border-radius: 18;
                                 -fx-padding: 28 28 24 28;">

                        <Label text="Write a Review"
                               style="-fx-font-size: 17px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>

                        <!-- Interactive stars -->
                        <VBox spacing="8">
                            <Label text="YOUR RATING"
                                   style="-fx-text-fill: #3e4560;
                                          -fx-font-size: 11px;
                                          -fx-font-weight: bold;
                                          -fx-letter-spacing: 1;"/>
                            <HBox fx:id="interactiveStarsBox" spacing="6" alignment="CENTER_LEFT"/>
                        </VBox>

                        <!-- Divider -->
                        <Separator opacity="0.12"
                                   style="-fx-background-color: #00d4ff;"/>

                        <!-- Comment textarea -->
                        <VBox spacing="8">
                            <Label text="YOUR THOUGHTS"
                                   style="-fx-text-fill: #3e4560;
                                          -fx-font-size: 11px;
                                          -fx-font-weight: bold;
                                          -fx-letter-spacing: 1;"/>
                            <TextArea fx:id="commentInput"
                                      prefHeight="110"
                                      promptText="Share your thoughts about this title…"
                                      wrapText="true"
                                      style="-fx-control-inner-background: rgba(255,255,255,0.04);
                                             -fx-text-fill: #c8d0e0;
                                             -fx-prompt-text-fill: #3a4055;
                                             -fx-background-radius: 12;
                                             -fx-border-color: rgba(0,212,255,0.18);
                                             -fx-border-radius: 12;
                                             -fx-font-size: 13px;
                                             -fx-focus-color: transparent;
                                             -fx-faint-focus-color: transparent;"/>
                        </VBox>

                        <!-- Submit button -->
                        <Button fx:id="btnSubmitComment" text="Post Review"
                                prefWidth="370" prefHeight="42"
                                style="-fx-background-color: linear-gradient(to right, #00d4ff 0%, #0080e0 100%);
                                       -fx-text-fill: #02040a;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 12;
                                       -fx-cursor: hand;">
                            <effect>
                                <DropShadow color="rgba(0,212,255,0.35)" radius="12" spread="0.08"/>
                            </effect>
                        </Button>
                    </VBox>
                </HBox>
            </VBox>
<!-- ─────────────────────────────────────────────────────── -->
<!--  WHAT TO WATCH NEXT                                      -->
<!-- ─────────────────────────────────────────────────────── -->
<VBox fx:id="watchNextContainer" spacing="0"
      style="-fx-padding: 0 0 48 0; -fx-background-color: transparent;"/>
        </VBox>
    </ScrollPane>

</StackPane>
