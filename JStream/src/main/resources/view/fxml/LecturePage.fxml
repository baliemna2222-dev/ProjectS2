<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="JStream.controller.LecturePageController"
           prefWidth="1010" prefHeight="800"
           style="-fx-background-color: radial-gradient(center 50% 50%, radius 100%, #08101a 0%, #02040a 100%);">

    <ImageView fx:id="backgroundImage" fitWidth="1280" fitHeight="520" preserveRatio="false" opacity="0.15"/>
    <Region prefWidth="1280" prefHeight="520" StackPane.alignment="TOP_LEFT"
            style="-fx-background-color: linear-gradient(to bottom, rgba(2,4,10,0) 0%, #02040a 100%);"/>

    <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                style="-fx-background: transparent; -fx-background-color: transparent; -fx-background-insets: 0;">

        <VBox fx:id="mainContainer" spacing="0">

            <HBox fx:id="navbar" alignment="CENTER_LEFT" prefHeight="65" spacing="25"
                  style="-fx-background-color: rgba(2,4,10,0.9); -fx-padding: 0 40 0 30; -fx-border-color: rgba(0,212,255,0.1); -fx-border-width: 0 0 1 0;">
                <Button fx:id="btnBack" text="← Back" style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: #00d4ff; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <ImageView fx:id="logoNav" fitHeight="35" preserveRatio="true"/>
                <HBox alignment="CENTER" spacing="25.0" HBox.hgrow="ALWAYS">
                   <Button fx:id="btnMostWatched" mnemonicParsing="false" 
                              style="-fx-background-color: transparent; -fx-text-fill: #7a80a0; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;" 
                              text="Most Watched" />
        
                   <Button fx:id="btnMyList" mnemonicParsing="false" 
                              style="-fx-background-color: transparent; -fx-text-fill: #7a80a0; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;" 
                              text="My List" />
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT" spacing="15">
                    <Button fx:id="btnNotification" style="-fx-background-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <StackPane fx:id="bellContainer">
                                <ImageView fx:id="bellIcon" fitWidth="22" fitHeight="22" preserveRatio="true"/>
                                <Circle fx:id="notificationCircle" radius="3" fill="#00d4ff" stroke="white" strokeWidth="1"
                                        translateX="8" translateY="-8" visible="false">
                                    <effect><Bloom/></effect>
                                </Circle>
                            </StackPane>
                        </graphic>
                    </Button>
                    <Button fx:id="profileBtn" prefWidth="36" prefHeight="36"
                            style="-fx-background-color: transparent; -fx-background-image: url('/assets/images/profile.png'); -fx-background-size: 34 34; -fx-border-color: #00d4ff; -fx-border-radius: 50;"/>
                </HBox>
            </HBox>

            <HBox prefHeight="480" spacing="50" style="-fx-padding: 45 60 30 50;">
                <ImageView fx:id="posterImage" fitWidth="280" fitHeight="410" preserveRatio="true"
                           style="-fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(0,212,255,0.4)" radius="40" spread="0.1" />
                    </effect>
                </ImageView>

                <VBox spacing="15" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label fx:id="titleLabel" text="Movie Title" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="scoreLabel" text="9.0" style="-fx-font-size: 24; -fx-text-fill: #00d4ff; -fx-font-weight: bold;"/>
                        </HBox>
                   <HBox >
                        <HBox fx:id="starsBox" spacing="5" alignment="CENTER_LEFT"/><effect><Bloom threshold="0.2" /> </effect>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="yearLabel" text="2024" style="-fx-text-fill: #7a80a0;"/>
                        <Label fx:id="durationLabel" text="120 min" style="-fx-text-fill: #7a80a0;"/>
                        <Label fx:id="ageRatingLabel" text="16+" style="-fx-border-color: #00d4ff; -fx-text-fill: #00d4ff; -fx-padding: 2 6;"/>
                        <Label fx:id="categoriesLabel" text="Action • Sci-Fi" style="-fx-text-fill: #00d4ff; -fx-font-weight: bold;"/>
                        <Label fx:id="episodeInfoLabel" text="S1-E1" style="-fx-text-fill: #00d4ff; -fx-font-weight: bold;" visible="false"/>
                    </HBox>

                    <HBox spacing="25" style="-fx-padding: 10 0 0 0;">
                        <VBox alignment="CENTER" spacing="5">
                            <Button fx:id="tabOverview" text="OVERVIEW" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                            <Rectangle fx:id="lineOverview" height="2" width="70" fill="#00d4ff">
                                <effect><Bloom/></effect>
                            </Rectangle>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5">
                            <Button fx:id="tabTrailers" text="TRAILERS" style="-fx-background-color: transparent; -fx-text-fill: #4e5670; -fx-cursor: hand;"/>
                            <Rectangle fx:id="lineTrailers" height="2" width="70" fill="#00d4ff" visible="false"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="descriptionLabel" wrapText="true" prefWidth="700"
                           style="-fx-text-fill: #a0a8c0; -fx-font-size: 15px; -fx-line-spacing: 5;"/>

                    <VBox spacing="8">
                        <HBox spacing="10">
                            <Label text="Starring:" style="-fx-text-fill: #4e5670;"/>
                            <Label fx:id="starringLabel" text="Actors..." style="-fx-text-fill: white;"/>
                        </HBox>
                        <HBox spacing="10">
                            <Label text="Director:" style="-fx-text-fill: #4e5670;"/>
                            <Label fx:id="directorLabel" text="Name..." style="-fx-text-fill: white;"/>
                        </HBox>
                    </VBox>

                    <HBox spacing="15" style="-fx-padding: 10 0 0 0;">
                        <Button fx:id="playButton" text="▶ Watch Now" prefHeight="48" prefWidth="170"
                                style="-fx-background-color: linear-gradient(to right, #00d4ff, #005fb8);
                                       -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;">
                            <effect>
                                <DropShadow color="#00d4ff" radius="20" spread="0.2" />
                            </effect>
                        </Button>
                        <Button fx:id="addToListButton"  text="+ My List" prefHeight="48" prefWidth="120"
                                style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white; -fx-background-radius: 25; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0);"/>
                    </HBox>
                </VBox>
            </HBox>

            <VBox spacing="20" style="-fx-padding: 30 60; -fx-background-color: rgba(0, 212, 255, 0.05);">
                <Label text="Cast &amp; Crew" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <HBox fx:id="castBox" spacing="30" alignment="CENTER_LEFT"/>
            </VBox>

        </VBox>
    </ScrollPane>
</StackPane>