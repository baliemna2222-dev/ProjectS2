<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="JStream.controller.LecturePageController"
            prefWidth="600" prefHeight="400">

    <VBox spacing="15" layoutX="20" layoutY="20">
        
        <!-- Title -->
        <Label fx:id="titleLabel" text="Title" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
        
        <HBox spacing="20">
            
            <!-- Poster Image -->
            <ImageView fx:id="posterImage" fitWidth="150" fitHeight="225" preserveRatio="true" />

            <!-- Details -->
            <VBox spacing="10">
                <Label fx:id="descriptionLabel" text="Description goes here" wrapText="true" prefWidth="400"/>
                <Label fx:id="durationLabel" text="Duration" />
                <HBox fx:id="starsBox" spacing="5"/>
                <Label fx:id="categoriesLabel" text="Categories" wrapText="true" prefWidth="400"/>
                <Label fx:id="episodeInfoLabel" text="Episode Info" wrapText="true" prefWidth="400"/>
                <Button fx:id="playTrailerButton" text="▶ Play Trailer" />
            </VBox>
            
        </HBox>
        
    </VBox>

</AnchorPane>