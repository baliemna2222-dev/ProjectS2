<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.CategoriesController"
      stylesheets="@/view/css/style.css"
      spacing="25"
      style="-fx-padding: 30; -fx-background-color: transparent;">

    <Label text="Category Management"
           style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0, 1, 1);" />

    <HBox spacing="15" alignment="CENTER_LEFT" 
          style="-fx-background-color: #ffffff1a; -fx-padding: 15; -fx-background-radius: 10;">
        <TextField fx:id="nameField" promptText="Category name" prefWidth="220" style="-fx-background-color: #2b323c; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;"/>
        <TextField fx:id="descriptionField" promptText="Description" prefWidth="320" style="-fx-background-color: #2b323c; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;"/>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="addButton" text="Add" onAction="#addCategory"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;"/>
        <Button fx:id="cancelEditButton" text="Cancel" onAction="#cancelEdit"
                visible="false" managed="false"
                style="-fx-background-color: transparent; -fx-text-fill: #f8fafc; -fx-border-color: rgba(255,255,255,0.24); -fx-border-radius: 8; -fx-padding: 10 20;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox fx:id="categoryListContainer" spacing="15" style="-fx-padding: 10;" />
    </ScrollPane>

</VBox>