<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.CategoriesController"
      stylesheets="@/view/css/style.css"
      spacing="25"
      styleClass="admin-root"
      style="-fx-padding: 30;">

    <Label text="Category Management"
           style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0, 1, 1);" />

    <HBox spacing="15" alignment="CENTER_LEFT" 
          styleClass="admin-card">
        <TextField fx:id="nameField" promptText="Category name" prefWidth="220" styleClass="admin-form-input"/>
        <TextField fx:id="descriptionField" promptText="Description" prefWidth="320" styleClass="admin-form-input"/>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="addButton" text="Add" onAction="#addCategory" styleClass="admin-primary-button"/>
        <Button fx:id="cancelEditButton" text="Cancel" onAction="#cancelEdit"
                visible="false" managed="false"
                styleClass="admin-secondary-button"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox fx:id="categoryListContainer" spacing="15" styleClass="admin-card" style="-fx-padding: 20;" />
    </ScrollPane>

</VBox>