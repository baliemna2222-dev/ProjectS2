<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="JStream.controller.FooterController"
            style="-fx-background-color: #000000;">
	
    <VBox spacing="60"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0"
          style="-fx-padding: 20 20 20 60;">
<Pane prefHeight="3"
      style="
        -fx-background-color: linear-gradient(to right, transparent, #0a1f44, #1e3a8a, #0a1f44, transparent);
        -fx-background-radius: 2;
        -fx-effect: dropshadow(gaussian, rgba(30,58,138,0.7), 10, 0.4, 0, 0);
      "/>
        <!-- ================= UNIQUE ================= -->
        <VBox spacing="20">
            <Label text="Why Raksha stands out"
                   style="-fx-text-fill: White; -fx-font-size: 26px; -fx-font-weight: bold;"/>

            <Label text="• Advanced AI recommendations tailored specifically to your taste"
                   style="-fx-text-fill: white; -fx-font-size: 17px;"/>

            <Label text="• High-quality streaming with ultra-fast performance and minimal buffering"
                   style="-fx-text-fill: white; -fx-font-size: 17px;"/>

            <Label text="• Continue watching from where you left off anytime, anywhere"
                   style="-fx-text-fill: white; -fx-font-size: 17px;"/>

            <Label text="• Create and manage your personalized watchlist effortlessly"
                   style="-fx-text-fill: white; -fx-font-size: 17px;"/>

            <Label text="• Discover trending, popular, and exclusive content curated daily"
                   style="-fx-text-fill: white; -fx-font-size: 17px;"/>
        </VBox>

     <Pane prefHeight="3"
      style="
        -fx-background-color: linear-gradient(to right, transparent, #0a1f44, #1e3a8a, #0a1f44, transparent);
        -fx-background-radius: 2;
        -fx-effect: dropshadow(gaussian, rgba(30,58,138,0.7), 10, 0.4, 0, 0);
      "/>
        <!-- ================= FAQ ================= -->
        <VBox spacing="20">
            <Label text="Frequently Asked Questions"
                   style="-fx-text-fill: White; -fx-font-size: 26px; -fx-font-weight: bold;"/>

            <!-- CARD -->
            <VBox style="-fx-background-color: #111; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 15,0.3,0,3);">
                <Button fx:id="q1" text="What is Raksha and how does it work?"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px;"/>
                <Label fx:id="a1"
                       text="Raksha is a modern streaming platform offering movies and series with personalized recommendations and seamless playback."
                       visible="false" managed="false"
                       style="-fx-text-fill: #dddddd; -fx-padding: 12 0 0 0; -fx-font-size: 15px;"/>
            </VBox>

            <VBox style="-fx-background-color: #111; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 15,0.3,0,3);">
                <Button fx:id="q2" text="How can I start watching on Raksha?"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px;"/>
                <Label fx:id="a2"
                       text="Simply create an account, explore the catalog, and start streaming instantly on any device."
                       visible="false" managed="false"
                       style="-fx-text-fill: #dddddd; -fx-padding: 12 0 0 0; -fx-font-size: 15px;"/>
            </VBox>

            <VBox style="-fx-background-color: #111; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 15,0.3,0,3);">
                <Button fx:id="q3" text="Does Raksha offer free content?"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px;"/>
                <Label fx:id="a3"
                       text="Raksha provides both free and premium plans, giving you access to a wide variety of content."
                       visible="false" managed="false"
                       style="-fx-text-fill: #dddddd; -fx-padding: 12 0 0 0; -fx-font-size: 15px;"/>
            </VBox>
        </VBox>

      <Pane prefHeight="3"
      style="
        -fx-background-color: linear-gradient(to right, transparent, #0a1f44, #1e3a8a, #0a1f44, transparent);
        -fx-background-radius: 2;
        -fx-effect: dropshadow(gaussian, rgba(30,58,138,0.7), 10, 0.4, 0, 0);
      "/>
        <!-- ================= LINKS ================= -->
     <HBox spacing="110">

    <!-- COMPANY -->
    <VBox spacing="12">
        <Label text="Company" style="-fx-text-fill: #00bfff; -fx-font-size: 18px;"/>
        <Label text="About Raksha" fx:id="aboutUs" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Careers" fx:id="careers" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Media" fx:id="press" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Investor Relations" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
    </VBox>

    <!-- SUPPORT -->
    <VBox spacing="12">
        <Label text="Support" style="-fx-text-fill: #00bfff; -fx-font-size: 18px;"/>
        <Label text="Help Center" fx:id="helpCenter" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Contact Us" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Terms of Use" fx:id="terms" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Privacy Policy" fx:id="privacy" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
    </VBox>

    <!-- ACCOUNT -->
    <VBox spacing="12">
        <Label text="Account" style="-fx-text-fill: #00bfff; -fx-font-size: 18px;"/>
        <Label text="Manage Profile" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Subscription Plans" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="My List" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Watch History" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
    </VBox>

    <!-- DISCOVER -->
    <VBox spacing="12">
        <Label text="Discover" style="-fx-text-fill: #00bfff; -fx-font-size: 18px;"/>
        <Label text="Popular Movies" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Trending Series" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="New Releases" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Top Rated" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
    </VBox>

    <!-- LEGAL -->
    <VBox spacing="12">
        <Label text="Legal" style="-fx-text-fill: #00bfff; -fx-font-size: 18px;"/>
        <Label text="Cookies Policy" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Security" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        <Label text="Accessibility" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
    </VBox>

    <!-- SOCIAL -->
    <VBox spacing="15">
        <Label text="Connect with us" style="-fx-text-fill: #00bfff; -fx-font-size: 18px;"/>

        <HBox spacing="20">
            <ImageView fx:id="fbIcon" fitWidth="32" fitHeight="32"/>
            <ImageView fx:id="twIcon" fitWidth="32" fitHeight="32"/>
            <ImageView fx:id="igIcon" fitWidth="32" fitHeight="32"/>
        </HBox>

        <Label text="Follow us for updates, new releases, and exclusive content"
               style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px; -fx-wrap-text: true;"/>
    </VBox>

</HBox>
<Pane prefHeight="3"
      style="
        -fx-background-color: linear-gradient(to right, transparent, #0a1f44, #1e3a8a, #0a1f44, transparent);
        -fx-background-radius: 2;
        -fx-effect: dropshadow(gaussian, rgba(30,58,138,0.7), 10, 0.4, 0, 0);
      "/>
        <!-- ================= FOOT ================= -->
        <HBox alignment="CENTER">
            <Label text="© 2026 Raksha. All rights reserved."
                   style="-fx-text-fill: grey; -fx-font-size: 16px;"/>
        </HBox>

    </VBox>
</AnchorPane>