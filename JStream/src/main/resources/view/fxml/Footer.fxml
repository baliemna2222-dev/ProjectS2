<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="JStream.controller.FooterController"
            style="-fx-background-color: #050810;">

    <VBox AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.topAnchor="0">

        <!-- TOP GLOW DIVIDER -->
        <Pane prefHeight="1" maxHeight="1"
              style="-fx-background-color: linear-gradient(to right,
                transparent 0%, #1a3a7a 20%, #2563eb 45%, #60a5fa 50%, #2563eb 55%, #1a3a7a 80%, transparent 100%);"/>
        <Pane prefHeight="6" maxHeight="6"
              style="-fx-background-color: linear-gradient(to bottom, rgba(96,165,250,0.25), transparent);"/>

        <!-- MAIN CONTENT -->
        <VBox spacing="0" style="-fx-padding: 64 80 0 80; -fx-background-color: transparent;">

            <!-- TOP ROW: BRAND + WHY US -->
            <HBox spacing="0" alignment="TOP_LEFT">

                <!-- BRAND COLUMN -->
                <VBox spacing="20" prefWidth="320" minWidth="280" style="-fx-padding: 0 60 0 0;">
                    <Label fx:id="brandName" text="RAKSHA"
                           style="-fx-text-fill: white; -fx-font-size: 38px; -fx-font-weight: bold; -fx-letter-spacing: 6;"/>
                    <Label text="Stream without limits."
                           style="-fx-text-fill: #60a5fa; -fx-font-size: 14px; -fx-font-style: italic;"/>
                    <Label text="Your world of cinema, series, and exclusive originals — curated just for you, available everywhere."
                           wrapText="true" style="-fx-text-fill: #8899bb; -fx-font-size: 13.5px; -fx-line-spacing: 4;"/>

                    <!-- Social Icons -->
                    <VBox spacing="10">
                        <Label text="Connect with us"
                               style="-fx-text-fill: #60a5fa; -fx-font-size: 12px; -fx-letter-spacing: 2;"/>
                        <HBox spacing="14">
                            <ImageView fx:id="fbIcon" fitWidth="36" fitHeight="36" style="-fx-cursor: hand;"/>
                            <ImageView fx:id="twIcon" fitWidth="36" fitHeight="36" style="-fx-cursor: hand;"/>
                            <ImageView fx:id="igIcon" fitWidth="36" fitHeight="36" style="-fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- VERTICAL SEPARATOR -->
                <Pane prefWidth="1" minWidth="1"
                      style="-fx-background-color: linear-gradient(to bottom, transparent, #1e3a8a 30%, #1e3a8a 70%, transparent);"/>
                <Pane prefWidth="60" minWidth="60"/>

                <!-- WHY RAKSHA -->
                <VBox spacing="18" HBox.hgrow="ALWAYS">
                    <Label text="Why Raksha stands out"
                           style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                    <VBox spacing="14">
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="◈" style="-fx-text-fill: #60a5fa; -fx-font-size: 16px;"/>
                            <Label text="Advanced AI recommendations tailored specifically to your taste"
                                   style="-fx-text-fill: #c8d8f0; -fx-font-size: 14px;"/>
                        </HBox>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="◈" style="-fx-text-fill: #60a5fa; -fx-font-size: 16px;"/>
                            <Label text="Ultra-fast 4K streaming with minimal buffering on any connection"
                                   style="-fx-text-fill: #c8d8f0; -fx-font-size: 14px;"/>
                        </HBox>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="◈" style="-fx-text-fill: #60a5fa; -fx-font-size: 16px;"/>
                            <Label text="Continue watching from where you left off, across all your devices"
                                   style="-fx-text-fill: #c8d8f0; -fx-font-size: 14px;"/>
                        </HBox>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="◈" style="-fx-text-fill: #60a5fa; -fx-font-size: 16px;"/>
                            <Label text="Create and manage your personalized watchlist effortlessly"
                                   style="-fx-text-fill: #c8d8f0; -fx-font-size: 14px;"/>
                        </HBox>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="◈" style="-fx-text-fill: #60a5fa; -fx-font-size: 16px;"/>
                            <Label text="Discover trending, popular, and exclusive content curated daily"
                                   style="-fx-text-fill: #c8d8f0; -fx-font-size: 14px;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>

            <Pane prefHeight="56"/>

            <!-- GLOW SEPARATOR -->
            <Pane prefHeight="1"
                  style="-fx-background-color: linear-gradient(to right, transparent 0%, #1a3a7a 20%, #2563eb 50%, #1a3a7a 80%, transparent 100%);"/>
            <Pane prefHeight="4" style="-fx-background-color: linear-gradient(to bottom, rgba(96,165,250,0.15), transparent);"/>
            <Pane prefHeight="48"/>

            <!-- FAQ SECTION -->
            <VBox spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label text="FAQ" style="-fx-text-fill: #60a5fa; -fx-font-size: 11px; -fx-letter-spacing: 4;"/>
                    <Pane prefHeight="1" HBox.hgrow="ALWAYS" style="-fx-background-color: #1e3a5a;"/>
                    <Label text="Frequently Asked Questions" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Pane prefHeight="1" HBox.hgrow="ALWAYS" style="-fx-background-color: #1e3a5a;"/>
                </HBox>

                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                    </columnConstraints>

                    <!-- FAQ Cards 1-3 -->
                    <VBox fx:id="faqCard1" GridPane.columnIndex="0" spacing="0"
                          style="-fx-background-color: #0c1428; -fx-background-radius: 14; -fx-border-color: #1e3a8a; -fx-border-width: 1; -fx-border-radius: 14; -fx-cursor: hand;">
                        <HBox style="-fx-padding: 20;" alignment="CENTER_LEFT" spacing="12">
                            <Label text="01" style="-fx-text-fill: #2563eb; -fx-font-size: 12px; -fx-font-style: italic;"/>
                            <Label text="What is Raksha and how does it work?" wrapText="true" HBox.hgrow="ALWAYS"
                                   style="-fx-text-fill: white; -fx-font-size: 14.5px; -fx-font-weight: bold;"/>
                            <Label fx:id="arrow1" text="›" style="-fx-text-fill: #60a5fa; -fx-font-size: 22px;"/>
                        </HBox>
                        <Label fx:id="a1" text="Raksha is a next-generation streaming platform offering movies and series with AI-powered personalized recommendations and seamless, high-quality playback."
                               visible="false" managed="false" wrapText="true"
                               style="-fx-text-fill: #8899bb; -fx-padding: 0 20 20 20; -fx-font-size: 13px;"/>
                        <Button fx:id="q1" text="" maxWidth="Infinity" maxHeight="Infinity"
                                style="-fx-background-color: transparent; -fx-padding: 0;"/>
                    </VBox>

                    <VBox fx:id="faqCard2" GridPane.columnIndex="1" spacing="0"
                          style="-fx-background-color: #0c1428; -fx-background-radius: 14; -fx-border-color: #1e3a8a; -fx-border-width: 1; -fx-border-radius: 14; -fx-cursor: hand;">
                        <HBox style="-fx-padding: 20;" alignment="CENTER_LEFT" spacing="12">
                            <Label text="02" style="-fx-text-fill: #2563eb; -fx-font-size: 12px; -fx-font-style: italic;"/>
                            <Label text="How can I start watching on Raksha?" wrapText="true" HBox.hgrow="ALWAYS"
                                   style="-fx-text-fill: white; -fx-font-size: 14.5px; -fx-font-weight: bold;"/>
                            <Label fx:id="arrow2" text="›" style="-fx-text-fill: #60a5fa; -fx-font-size: 22px;"/>
                        </HBox>
                        <Label fx:id="a2" text="Create a free account in seconds, explore our curated catalog, and start streaming instantly on any device — desktop, mobile, or tablet."
                               visible="false" managed="false" wrapText="true"
                               style="-fx-text-fill: #8899bb; -fx-padding: 0 20 20 20; -fx-font-size: 13px;"/>
                        <Button fx:id="q2" text="" maxWidth="Infinity" maxHeight="Infinity"
                                style="-fx-background-color: transparent; -fx-padding: 0;"/>
                    </VBox>

                    <VBox fx:id="faqCard3" GridPane.columnIndex="2" spacing="0"
                          style="-fx-background-color: #0c1428; -fx-background-radius: 14; -fx-border-color: #1e3a8a; -fx-border-width: 1; -fx-border-radius: 14; -fx-cursor: hand;">
                        <HBox style="-fx-padding: 20;" alignment="CENTER_LEFT" spacing="12">
                            <Label text="03" style="-fx-text-fill: #2563eb; -fx-font-size: 12px; -fx-font-style: italic;"/>
                            <Label text="Does Raksha offer free content?" wrapText="true" HBox.hgrow="ALWAYS"
                                   style="-fx-text-fill: white; -fx-font-size: 14.5px; -fx-font-weight: bold;"/>
                            <Label fx:id="arrow3" text="›" style="-fx-text-fill: #60a5fa; -fx-font-size: 22px;"/>
                        </HBox>
                        <Label fx:id="a3" text="Yes — Raksha offers both free-tier and premium plans, giving everyone access to a rich library. Upgrade for 4K, offline downloads, and exclusive originals."
                               visible="false" managed="false" wrapText="true"
                               style="-fx-text-fill: #8899bb; -fx-padding: 0 20 20 20; -fx-font-size: 13px;"/>
                        <Button fx:id="q3" text="" maxWidth="Infinity" maxHeight="Infinity"
                                style="-fx-background-color: transparent; -fx-padding: 0;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <Pane prefHeight="52"/>

            <!-- LINKS GRID -->
            <HBox spacing="0">
                <!-- COMPANY -->
                <VBox spacing="14" HBox.hgrow="ALWAYS">
                    <Label text="COMPANY" style="-fx-text-fill: #60a5fa; -fx-font-size: 11px; -fx-letter-spacing: 3; -fx-font-weight: bold;"/>
                    <Label fx:id="aboutUs" text="About Raksha" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label fx:id="careers" text="Careers" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label fx:id="press" text="Media" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label text="Investor Relations" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                </VBox>

                <!-- SUPPORT -->
                <VBox spacing="14" HBox.hgrow="ALWAYS">
                    <Label text="SUPPORT" style="-fx-text-fill: #60a5fa; -fx-font-size: 11px; -fx-letter-spacing: 3; -fx-font-weight: bold;"/>
                    <Label fx:id="helpCenter" text="Help Center" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label text="Contact Us" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label fx:id="terms" text="Terms of Use" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label fx:id="privacy" text="Privacy Policy" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                </VBox>

                <!-- ACCOUNT -->
                <VBox spacing="14" HBox.hgrow="ALWAYS">
                    <Label text="ACCOUNT" style="-fx-text-fill: #60a5fa; -fx-font-size: 11px; -fx-letter-spacing: 3; -fx-font-weight: bold;"/>
                    <Label text="Manage Profile" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label text="Subscription Plans" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label text="My List" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label text="Watch History" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                </VBox>

                <!-- DISCOVER -->
                <VBox spacing="14" HBox.hgrow="ALWAYS">
                    <Label text="DISCOVER" style="-fx-text-fill: #60a5fa; -fx-font-size: 11px; -fx-letter-spacing: 3; -fx-font-weight: bold;"/>
                    <Label text="Popular Movies" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label text="Trending Series" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label text="New Releases" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label text="Top Rated" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                </VBox>

                <!-- LEGAL -->
                <VBox spacing="14" HBox.hgrow="ALWAYS">
                    <Label text="LEGAL" style="-fx-text-fill: #60a5fa; -fx-font-size: 11px; -fx-letter-spacing: 3; -fx-font-weight: bold;"/>
                    <Label text="Cookies Policy" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label text="Security" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    <Label text="Accessibility" style="-fx-text-fill: #8899bb; -fx-font-size: 14px; -fx-cursor: hand;"/>
                </VBox>
            </HBox>

            <Pane prefHeight="52"/>
        </VBox>

        <!-- BOTTOM BAR -->
        <Pane VBox.vgrow="ALWAYS"/>
        <VBox style="-fx-background-color: #04060f; -fx-padding: 18 80;">
            <Pane prefHeight="1" style="-fx-background-color: linear-gradient(to right, transparent, #0f2040 30%, #0f2040 70%, transparent);"/>
            <Pane prefHeight="16"/>
            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label text="© 2026 Raksha. All rights reserved." style="-fx-text-fill: #445566; -fx-font-size: 13px;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label text="Made with ◈ for cinema lovers" style="-fx-text-fill: #2a3d5a; -fx-font-size: 13px; -fx-font-style: italic;"/>
            </HBox>
        </VBox>

    </VBox>
</AnchorPane>