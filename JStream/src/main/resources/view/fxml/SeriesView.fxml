<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="JStream.controller.SeriesViewController"
           stylesheets="@/view/css/scrollbar.css"
           style="-fx-background-color: black;">

    <!-- ================= MAIN SCROLLABLE AREA ================= -->
    <ScrollPane fx:id="mainScroll"
                fitToWidth="true"
                vbarPolicy="AS_NEEDED"
                hbarPolicy="NEVER"
                style="-fx-background: black; -fx-background-color: black; -fx-control-inner-background: black; -fx-background-insets: 0;">

        <!-- StackPane to allow header to float above content -->
        <StackPane>

            <!-- ================= MAIN CONTENT ================= -->
            <VBox fx:id="Home"
                  spacing="20"
                  style="-fx-background-color: black; -fx-padding: 150 20 20 20;">

                <!-- Top-rated series / dynamic carousels -->
                <VBox fx:id="categoryContainer" spacing="20">
                    <!-- Filter bar and results will be added dynamically -->
                </VBox>
				<fx:include source="Footer.fxml"/> 
            </VBox>

            <!-- ================= FLOATING HEADER ================= -->
            <fx:include source="Header.fxml"/>

        </StackPane>
        
    </ScrollPane>
    
</StackPane>