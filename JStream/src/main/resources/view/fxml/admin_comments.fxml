<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="JStream.controller.AdminCommentsController"
      stylesheets="@/view/css/style.css,@/view/css/scrollbar.css"
      spacing="0"
      styleClass="admin-root"
      style="-fx-min-height: 600px;">

    <!-- ── Top header bar ──────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          styleClass="admin-page-header">

        <Label text="🚨"
               style="-fx-font-size: 28px;"/>

        <VBox spacing="2">
            <Label text="Comment Moderation"
                   style="-fx-text-fill: white;
                          -fx-font-size: 26px;
                          -fx-font-weight: bold;"/>
            <Label fx:id="countLabel"
                   text="Loading..."
                   styleClass="admin-badge"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
        </VBox>

    </HBox>
 
    <!-- ── Scrollable cards area ────────────────────────────────────────── -->
    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;
                       -fx-background: transparent;
                       -fx-control-inner-background: transparent;
                       -fx-border-color: transparent;">

        <VBox fx:id="commentsContainer"
              spacing="16"
              styleClass="admin-card"
              style="-fx-padding: 24 28 28 28;">
        </VBox>

    </ScrollPane>

</VBox>