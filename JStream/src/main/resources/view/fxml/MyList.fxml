<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="JStream.controller.MyListController"
           stylesheets="@/view/css/scrollbar.css"
           style="-fx-background-color: black;">
    <!-- ================= HEADER ================= -->
    

    <!-- ================= SCROLLABLE CONTENT ================= -->
    <ScrollPane fx:id="mainScroll"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="-fx-background: #121212; -fx-control-inner-background: #121212; -fx-background-insets: 0;">
	<StackPane>
        <VBox alignment="TOP_LEFT" spacing="40" style="-fx-padding: 150 20 20 20;">

            <!-- Username Display -->
            <HBox alignment="CENTER" spacing="10" >
                <Label fx:id="usernameLabel" text="Welcome, User123 !"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <font>
                        <Font name="System Italic" size="20"/>
                    </font>
                </Label>
            </HBox>

            <!-- My Films Section -->
            <VBox alignment="TOP_LEFT" spacing="20">
                <Label text="My Films"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <padding>
                        <Insets bottom="10"/>
                    </padding>
                </Label>
                <TilePane fx:id="filmContainer"
                          hgap="20"
                          vgap="20"
                          prefColumns="4">
                    <padding>
                        <Insets left="20" right="10"/>
                    </padding>
                </TilePane>
            </VBox>

            <!-- My Series Section -->
            <VBox alignment="TOP_LEFT" spacing="20">
                <Label text="My Series"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <padding>
                        <Insets bottom="10"/>
                    </padding>
                </Label>
                <TilePane fx:id="serieContainer"
                          hgap="20"
                          vgap="20"
                          prefColumns="4">
                    <padding>
                        <Insets left="20" right="10"/>
                    </padding>
                </TilePane>
            </VBox>

        </VBox>
        <fx:include source="Header.fxml"/>
        </StackPane>
    </ScrollPane>

</StackPane>