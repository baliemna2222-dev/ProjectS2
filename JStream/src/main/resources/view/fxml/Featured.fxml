<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane fx:id="rootPane" prefHeight="700" style="-fx-background-color:black;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="JStream.controller.FeaturedController">
    
        <HBox mouseTransparent="true" prefHeight="700" prefWidth="1550">
            <Region mouseTransparent="true" prefWidth="700" /> <!-- left space -->
            <StackPane mouseTransparent="true" prefHeight="700" prefWidth="1120" HBox.hgrow="ALWAYS">
                <ImageView fx:id="heroBackground" fitHeight="700" fitWidth="1000" mouseTransparent="true" preserveRatio="false" style="-fx-cursor:hand;" />
               <Rectangle fill="linear-gradient(to right, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0) 100%)" height="700" mouseTransparent="true" width="1000" /> 
    </StackPane>
        </HBox>

        <VBox alignment="CENTER_LEFT" style="-fx-padding:0 0 70 50;" StackPane.alignment="CENTER_LEFT">
            <ImageView fx:id="heroTitleImage" fitHeight="300" fitWidth="600" mouseTransparent="true" preserveRatio="true" />
            <HBox alignment="CENTER_LEFT" spacing="12">
                <HBox fx:id="heroStars" spacing="3" style="-fx-effect:dropshadow(gaussian,#00aaff,10,0,0,0);" />
                <Label fx:id="heroCategories" style="-fx-text-fill:white;-fx-font-size:14;-fx-font-weight:bold;-fx-padding:2 3;" />
                <Label fx:id="heroAge" style="-fx-background-color:#ff0033;-fx-text-fill:white;-fx-font-weight:bold;-fx-padding:2 3;-fx-background-radius:2;-fx-effect:dropshadow(gaussian,#ff0033,5,0.3,0,0);" />
            	 <Label fx:id="lastEpisodeLabel" style="-fx-background-color:#ff0033; -fx-text-fill:white; -fx-font-weight:bold;                       -fx-padding:2 6; -fx-background-radius:2; -fx-effect:dropshadow(gaussian,#ff0033,5,0.3,0,0);" text="S3:E7" />
        <Label fx:id="seriesStatusLabel" style="-fx-background-color:#ff0033; -fx-text-fill:white; -fx-font-weight:bold;                       -fx-padding:2 6; -fx-background-radius:2; -fx-effect:dropshadow(gaussian,#ff0033,5,0.3,0,0);" text="Ongoing" />
 
            </HBox>

            <Label fx:id="heroDescription" maxWidth="600" style="-fx-text-fill:white;-fx-font-size:16;-fx-padding:2 3;" wrapText="true" />
        </VBox>
  <HBox fx:id="typeTag" alignment="BOTTOM_RIGHT" prefHeight="80.0" prefWidth="50.0">

     <children>

        <!-- ⚪ Thin vertical line (NOT glowing too much) -->
        <Rectangle fx:id="typeLine" fill="white" height="40.0" opacity="0.8" width="3.0">
            <HBox.margin>
               <Insets />
            </HBox.margin></Rectangle>

        <!-- ⚪ Clean text -->
        <Label fx:id="typeLabel" prefHeight="42.0" prefWidth="120.0" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: normal; -fx-background-color: rgba(0,0,0,0.5);" text="    TV-MA" textAlignment="CENTER">
            <opaqueInsets>
               <Insets left="0.0" />
            </opaqueInsets>
            <HBox.margin>
               <Insets />
            </HBox.margin></Label>

    </children>

    <padding>
        <Insets bottom="100.0" right="0.0" />
    </padding>
</HBox>

         

        <HBox alignment="BOTTOM_LEFT" spacing="20" style="-fx-padding:0 0 30 0;" StackPane.alignment="BOTTOM_CENTER">
           <HBox alignment="BOTTOM_LEFT" spacing="16" style="-fx-padding: 50 50 100 50;" StackPane.alignment="BOTTOM_CENTER">
             <Button fx:id="playButton" style="-fx-background-color:#008cff;-fx-text-fill:white;-fx-font-size:16;-fx-font-weight:bold;-fx-padding:6 20;-fx-background-radius:4;-fx-effect:dropshadow(gaussian,#00aaff,10,0,0,0);" text="▶ Watch now" />
             <Button fx:id="watchTrailerButton" style="-fx-background-color:#333;-fx-text-fill:white;-fx-font-size:16;-fx-font-weight:bold;-fx-padding:6 20;-fx-background-radius:4;" text="🎬 Watch Trailer" />
             <Button fx:id="addToListButton" style="-fx-background-color:transparent;-fx-border-color:#00aaff;-fx-border-width:2;-fx-text-fill:#00aaff;-fx-font-size:16;-fx-padding:6 20;" text="➕ My List" />
         </HBox>
         <HBox fx:id="filmNavigation" alignment="BOTTOM_LEFT" prefHeight="630.0" prefWidth="321.0" spacing="6" style="-fx-padding:0 0 0 50;">
            <Rectangle fx:id="rect1" arcHeight="3" arcWidth="3" fill="#888888" height="5" width="14" />
            <Rectangle fx:id="rect2" arcHeight="3" arcWidth="3" fill="#888888" height="5" width="14" />
            <Rectangle fx:id="rect3" arcHeight="3" arcWidth="3" fill="#888888" height="5" width="14" />
            <Rectangle fx:id="rect4" arcHeight="3" arcWidth="3" fill="#888888" height="5" width="14" />
            <Rectangle fx:id="rect5" arcHeight="3" arcWidth="3" fill="#888888" height="5" width="14" />
         <HBox.margin>
            <Insets left="150.0" />
         </HBox.margin>
        </HBox>
        </HBox>
   
</StackPane>
