-- ============================================================
-- JStream Database Script
-- ============================================================

CREATE DATABASE IF NOT EXISTS jstream CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE jstream;

-- ============================================================
-- TABLE: users
-- ============================================================
CREATE TABLE IF NOT EXISTS users (
    user_id     INT AUTO_INCREMENT PRIMARY KEY,
    username    VARCHAR(100)        NOT NULL,
    email       VARCHAR(150)        NOT NULL UNIQUE,
    password    VARCHAR(255)        NOT NULL,   -- BCrypt hash
    role        ENUM('USER','ADMIN') NOT NULL DEFAULT 'USER',
    created_at  TIMESTAMP           NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ============================================================
-- TABLE: categories
-- ============================================================
CREATE TABLE IF NOT EXISTS categories (
    category_id  INT AUTO_INCREMENT PRIMARY KEY,
    name         VARCHAR(100) NOT NULL UNIQUE,
    description  TEXT,
    created_at   TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ============================================================
-- TABLE: films
-- ============================================================
CREATE TABLE IF NOT EXISTS films (
    film_id         INT AUTO_INCREMENT PRIMARY KEY,
    title           VARCHAR(255)    NOT NULL,
    synopsis        TEXT,
    casting         TEXT,
    video_url       VARCHAR(500),
    image_url       VARCHAR(500),
    title_image_url VARCHAR(500),
    poster_url      VARCHAR(500),
    release_date    DATETIME,
    updated_at      TIMESTAMP       NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    duration        DOUBLE          NOT NULL DEFAULT 0,
    age_rating      VARCHAR(10),
    rating          INT             NOT NULL DEFAULT 0
);

-- ============================================================
-- TABLE: film_categories  (junction)
-- ============================================================
CREATE TABLE IF NOT EXISTS film_categories (
    film_id     INT NOT NULL,
    category_id INT NOT NULL,
    PRIMARY KEY (film_id, category_id),
    FOREIGN KEY (film_id)     REFERENCES films(film_id)      ON DELETE CASCADE,
    FOREIGN KEY (category_id) REFERENCES categories(category_id) ON DELETE CASCADE
);

-- ============================================================
-- TABLE: series
-- ============================================================
CREATE TABLE IF NOT EXISTS series (
    serie_id        INT AUTO_INCREMENT PRIMARY KEY,
    title           VARCHAR(255) NOT NULL,
    synopsis        TEXT,
    casting         TEXT,
    image_url       VARCHAR(500),
    title_image_url VARCHAR(500),
    poster_url      VARCHAR(500),
    trailer_url     VARCHAR(500),
    age_rating      VARCHAR(10),
    created_at      TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ============================================================
-- TABLE: serie_categories  (junction)
-- ============================================================
CREATE TABLE IF NOT EXISTS serie_categories (
    serie_id    INT NOT NULL,
    category_id INT NOT NULL,
    PRIMARY KEY (serie_id, category_id),
    FOREIGN KEY (serie_id)    REFERENCES series(serie_id)    ON DELETE CASCADE,
    FOREIGN KEY (category_id) REFERENCES categories(category_id) ON DELETE CASCADE
);

-- ============================================================
-- TABLE: seasons
-- ============================================================
CREATE TABLE IF NOT EXISTS seasons (
    season_id         INT AUTO_INCREMENT PRIMARY KEY,
    serie_id          INT          NOT NULL,
    season_num        INT          NOT NULL,
    title             VARCHAR(255),
    synopsis          TEXT,
    trailer_url       VARCHAR(500),
    poster_url        VARCHAR(500),
    title_url         VARCHAR(500),
    image_url         VARCHAR(500),
    created_at        TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
    planned_episodes  INT          NOT NULL DEFAULT 0,
    status            ENUM('Ongoing','Completed') NOT NULL DEFAULT 'Ongoing',
    rating            INT          NOT NULL DEFAULT 0,
    FOREIGN KEY (serie_id) REFERENCES series(serie_id) ON DELETE CASCADE,
    UNIQUE KEY uq_serie_season (serie_id, season_num)
);

-- ============================================================
-- TABLE: episodes
-- ============================================================
CREATE TABLE IF NOT EXISTS episodes (
    ep_id        INT AUTO_INCREMENT PRIMARY KEY,
    season_id    INT          NOT NULL,
    num_episode  INT          NOT NULL,
    title        VARCHAR(255),
    duration     INT          NOT NULL DEFAULT 0,   -- in seconds
    resume       TEXT,
    video_url    VARCHAR(500),
    covert_url   VARCHAR(500),
    rating       INT          NOT NULL DEFAULT 0,
    created_at   TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
    released_at  TIMESTAMP    NULL,
    FOREIGN KEY (season_id) REFERENCES seasons(season_id) ON DELETE CASCADE,
    UNIQUE KEY uq_season_episode (season_id, num_episode)
);

-- ============================================================
-- TABLE: watchlist  (Ma Liste)
-- ============================================================
CREATE TABLE IF NOT EXISTS watchlist (
    id         INT AUTO_INCREMENT PRIMARY KEY,
    user_id    INT       NOT NULL,
    film_id    INT       NOT NULL DEFAULT 0,
    serie_id   INT       NOT NULL DEFAULT 0,
    added_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ============================================================
-- TABLE: history  (viewing history)
-- ============================================================
CREATE TABLE IF NOT EXISTS history (
    id                    INT AUTO_INCREMENT PRIMARY KEY,
    user_id               INT       NOT NULL,
    film_id               INT       NOT NULL DEFAULT 0,
    episode_id            INT       NOT NULL DEFAULT 0,
    progression_secondes  INT       NOT NULL DEFAULT 0,
    completed             BOOLEAN   NOT NULL DEFAULT FALSE,
    watched_at            TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at            TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ============================================================
-- TABLE: ratings
-- ============================================================
CREATE TABLE IF NOT EXISTS ratings (
    rating_id  INT AUTO_INCREMENT PRIMARY KEY,
    user_id    INT       NOT NULL,
    film_id    INT       NOT NULL DEFAULT 0,
    serie_id   INT       NOT NULL DEFAULT 0,
    note       INT       NOT NULL CHECK (note BETWEEN 1 AND 5),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ============================================================
-- TABLE: comments
-- ============================================================
CREATE TABLE IF NOT EXISTS comments (
    comment_id  INT AUTO_INCREMENT PRIMARY KEY,
    user_id     INT       NOT NULL,
    film_id     INT       NOT NULL DEFAULT 0,
    serie_id    INT       NOT NULL DEFAULT 0,
    content     TEXT      NOT NULL,
    flagged     BOOLEAN   NOT NULL DEFAULT FALSE,
    created_at  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

