-- ================================================================
--   J-STREAM  –  database.sql
--   Projet : CPI-2 Java Avancé / JavaFX
--   Base   : jstreamdb
--   Tables : 12  (category, users, film, film_category,
--                 serie, serie_category, season, episode,
--                 rating, comment, watchlist, history)
--
--   HOW TO RUN :
--     mysql -u root -p < database.sql
--   OR open in phpMyAdmin / MySQL Workbench and execute.
-- ================================================================

DROP DATABASE IF EXISTS jstreamdb;
CREATE DATABASE jstreamdb
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;
USE jstreamdb;

-- ----------------------------------------------------------------
-- Disable FK checks during creation to avoid ordering issues
-- ----------------------------------------------------------------
SET FOREIGN_KEY_CHECKS = 0;

-- ================================================================
-- TABLE 1 : category
-- ================================================================
CREATE TABLE category (
    category_id  INT          AUTO_INCREMENT PRIMARY KEY,
    name         VARCHAR(100) NOT NULL UNIQUE,
    description  TEXT,
    created_at   TIMESTAMP    DEFAULT CURRENT_TIMESTAMP
);

-- ================================================================
-- TABLE 2 : users
-- ================================================================
CREATE TABLE users (
    id        INT          AUTO_INCREMENT PRIMARY KEY,
    username  VARCHAR(100) NOT NULL UNIQUE,
    email     VARCHAR(150) NOT NULL UNIQUE,
    password  VARCHAR(255) NOT NULL,          -- BCrypt hash, NEVER plain text
    role      ENUM('USER','ADMIN') NOT NULL DEFAULT 'USER'
);

-- ================================================================
-- TABLE 3 : film
-- ================================================================
CREATE TABLE film (
    film_id          INT          AUTO_INCREMENT PRIMARY KEY,
    title            VARCHAR(255) NOT NULL,
    synopsis         TEXT,
    casting          TEXT,
    video_url        VARCHAR(500) NOT NULL,
    image_url        VARCHAR(500),
    title_image_url  VARCHAR(500),
    poster_url       VARCHAR(500),
    release_date     DATE,
    updated_at       TIMESTAMP    DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    duration         DOUBLE,                  -- minutes
    age_rating       VARCHAR(10),             -- "PG-13" | "16+" | "18+"
    rating           INT          DEFAULT 0,
    view_count       INT          NOT NULL DEFAULT 0
);

-- ================================================================
-- TABLE 4 : film_category   (Film ←→ Category  many-to-many)
-- ================================================================
CREATE TABLE film_category (
    film_id     INT NOT NULL,
    category_id INT NOT NULL,
    PRIMARY KEY (film_id, category_id),
    CONSTRAINT fk_fc_film     FOREIGN KEY (film_id)     REFERENCES film(film_id)           ON DELETE CASCADE,
    CONSTRAINT fk_fc_category FOREIGN KEY (category_id) REFERENCES category(category_id)   ON DELETE CASCADE
);

-- ================================================================
-- TABLE 5 : serie
-- ================================================================
CREATE TABLE serie (
    serie_id    INT          AUTO_INCREMENT PRIMARY KEY,
    title      VARCHAR(255) NOT NULL,
    synopsis   TEXT,
    casting    TEXT,
    covert_url  VARCHAR(500),
    created_at TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP    DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    rating     INT          DEFAULT 0,
    age_rating VARCHAR(10)
);

-- ================================================================
-- TABLE 6 : serie_category  (Serie ←→ Category  many-to-many)
-- ================================================================
CREATE TABLE serie_category (
    serie_id     INT NOT NULL,
    category_id INT NOT NULL,
    PRIMARY KEY (serie_idd, category_id),
    CONSTRAINT fk_sc_serie    FOREIGN KEY (serie_id)     REFERENCES serie(serie_id)          ON DELETE CASCADE,
    CONSTRAINT fk_sc_category FOREIGN KEY (category_id) REFERENCES category(category_id)   ON DELETE CASCADE
);

-- ================================================================
-- TABLE 7 : season
-- ================================================================
CREATE TABLE season (
    season_id         INT          AUTO_INCREMENT PRIMARY KEY,
    serie_id          INT          NOT NULL,
    season_num        INT          NOT NULL,   -- 1, 2, 3 …
    title            VARCHAR(255),
    synopsis         TEXT,
    trailer_url       VARCHAR(500),
    poster_url        VARCHAR(500),
    title_url         VARCHAR(500),            -- logo / title image
    image_url         VARCHAR(500),
    created_at        TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    planned_episodes  INT          DEFAULT 0,
    status           VARCHAR(20)  DEFAULT 'Ongoing',  -- 'Ongoing' | 'Completed'
    rating           INT          DEFAULT 0,
    CONSTRAINT fk_season_serie FOREIGN KEY (serie_id) REFERENCES serie(serie_id) ON DELETE CASCADE
);

-- ================================================================
-- TABLE 8 : episode
-- ================================================================
CREATE TABLE episode (
    ep_id        INT          AUTO_INCREMENT PRIMARY KEY,
    season_id    INT          NOT NULL,
    num_episode  INT          NOT NULL,
    title       VARCHAR(255) NOT NULL,
    duration    VARCHAR(20),                  -- ISO-8601 e.g. "PT48M"  →  Java Duration.parse()
    resume      TEXT,                         -- short synopsis
    video_url    VARCHAR(500) NOT NULL,
    covert_url   VARCHAR(500),
    rating      INT          DEFAULT 0,
    created_at   TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
    released_at  TIMESTAMP    NULL DEFAULT NULL,
    CONSTRAINT fk_ep_season FOREIGN KEY (season_id) REFERENCES season(season_id) ON DELETE CASCADE
);

-- ================================================================
-- TABLE 9 : rating
-- ================================================================
CREATE TABLE rating (
    rating_id  INT       AUTO_INCREMENT PRIMARY KEY,
    user_id     INT       NOT NULL,
    film_id     INT,
    serie_id    INT,
    note       INT       NOT NULL CHECK (note BETWEEN 1 AND 5),
    creates_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT fk_r_user  FOREIGN KEY (user_id)  REFERENCES users(id)        ON DELETE CASCADE,
    CONSTRAINT fk_r_film  FOREIGN KEY (film_id)  REFERENCES film(film_id)    ON DELETE CASCADE,
    CONSTRAINT fk_r_serie FOREIGN KEY (serie_id) REFERENCES serie(serie_id)   ON DELETE CASCADE,
    -- One rating per user per film (or per serie)
    UNIQUE KEY uq_r_film  (user_id, film_id),
    UNIQUE KEY uq_r_serie (user_id, serie_id)
);

-- ================================================================
-- TABLE 10 : comment
-- ================================================================
CREATE TABLE comment (
    comment_id INT       AUTO_INCREMENT PRIMARY KEY,
    user_id     INT       NOT NULL,
    film_id     INT,
    serie_id    INT,
    content    TEXT      NOT NULL,
    is_flagged TINYINT(1) NOT NULL DEFAULT 0,
    creates_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT fk_c_user  FOREIGN KEY (user_id)  REFERENCES users(id)        ON DELETE CASCADE,
    CONSTRAINT fk_c_film  FOREIGN KEY (film_id)  REFERENCES film(film_id)    ON DELETE CASCADE,
    CONSTRAINT fk_c_serie FOREIGN KEY (serie_id) REFERENCES serie(serie_id)   ON DELETE CASCADE
);

-- ================================================================
-- TABLE 11 : watchlist  ("Ma Liste")
-- ================================================================
CREATE TABLE watchlist (
    watchlist_id       INT       AUTO_INCREMENT PRIMARY KEY,
    user_id   INT       NOT NULL,
    film_id   INT,
    serie_id  INT,
    added_at  TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_w_user  FOREIGN KEY (user_id)  REFERENCES users(id)        ON DELETE CASCADE,
    CONSTRAINT fk_w_film  FOREIGN KEY (film_id)  REFERENCES film(film_id)    ON DELETE CASCADE,
    CONSTRAINT fk_w_serie FOREIGN KEY (serie_id) REFERENCES serie(serie_id)   ON DELETE CASCADE,
    -- A film or serie can appear only once per user
    UNIQUE KEY uq_w_film  (user_id, filmI_id),
    UNIQUE KEY uq_w_serie (user_id, serie_id)
);

-- ================================================================
-- TABLE 12 : history  (viewing progress + resume feature)
-- ================================================================
CREATE TABLE history (
    id                   INT       AUTO_INCREMENT PRIMARY KEY,
    user_id               INT       NOT NULL,
    film_id               INT,
    episode_id            INT,
    progression_secondes  INT       NOT NULL DEFAULT 0,   -- seconds watched so far
    completed            TINYINT(1) NOT NULL DEFAULT 0,  -- 1 = fully watched
    watched_at            TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at            TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT fk_h_user    FOREIGN KEY (user_id)    REFERENCES users(id)        ON DELETE CASCADE,
    CONSTRAINT fk_h_film    FOREIGN KEY (film_id)    REFERENCES film(film_id)    ON DELETE CASCADE,
    CONSTRAINT fk_h_episode FOREIGN KEY (episode_id) REFERENCES episode(ep_id)    ON DELETE CASCADE
);

-- ----------------------------------------------------------------
SET FOREIGN_KEY_CHECKS = 1;
